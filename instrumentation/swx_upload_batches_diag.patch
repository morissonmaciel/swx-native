+// "in 1 batches (0 split)" when it did not.
+static _Atomic uint64_t g_swx_up_batches, g_swx_up_split_batches;
+void mtl_swx_up_batches(uint64_t *batches, uint64_t *split_batches) { *batches = atomic_load(&g_swx_up_batches); *split_batches = atomic_load(&g_swx_up_split_batches); }
 
 
