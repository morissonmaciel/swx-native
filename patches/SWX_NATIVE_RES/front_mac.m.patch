+// Native-resolution bypass (SWX_NATIVE_RES, loader.c dm_fps_state_apply): the game's stubs render the preset's size instead of the stock one (state +0xB4, forced
+// here at boot while the loader keeps it 0). The window shows it 1:1 (the drawable is fixed at the preset), fullscreen scales it per DM_PRESENT_UPSCALE (the drawable
+// follows the view). Only docked, and only a build whose stubs declare the preset (swx_res_bypass_requested, validated by the loader from the same variable)
+static NSWindow *g_bp_win; static int g_bp_on, g_bp_fixed, g_bp_trans; static NSUInteger g_bp_screen; static NSRect g_bp_frame; static int g_bp_mode, g_bp_w = 1920, g_bp_h = 1080;
+static int bp_preset(int *w, int *h) {   // the SWX_NATIVE_RES preset's mode and size, 0 when unset, off or unknown
+    const char *e = getenv("SWX_NATIVE_RES");
+    if (!e || !*e || !strcmp(e, "0")) return 0;
+    if (!strcmp(e, "1080p")) { *w = 1920; *h = 1080; return 1; }
+    if (!strcmp(e, "1440p")) { *w = 2560; *h = 1440; return 2; }
+    if (!strcmp(e, "2160p")) { *w = 3840; *h = 2160; return 3; }
+    return 0;
+}
+static int bp_requested(void) {   // 1 when the preset names a bypass mode and the loader validated it for this build
+    int w = 0, h = 0, mode = bp_preset(&w, &h);
+    if (!mode || !swx_res_bypass_requested()) return 0;
+    g_bp_mode = mode; g_bp_w = w; g_bp_h = h; return 1;
+}
+// Windowed bypass enforcement: size the window in points to preset / scale so its backing lands on the
+// preset, then let fitDrawable measure the view's real backing (no contentsScale = 1.0). Fullscreen leaves the
+// drawable to the view so DM_PRESENT_UPSCALE (metalfx) upscales the preset to the screen. Returns 1 when the
+// window was (or already is) enforced, 0 when not bypass windowed (fullscreen, transition in flight, no bypass).
+static int bp_enforce_windowed(void) {
+    if (!g_bp_on || !g_bp_fixed || g_bp_trans) return 0;
+    if (!g_bp_win || !g_layer) return 0;
+    if (g_fullscreen || (g_bp_win.styleMask & NSWindowStyleMaskFullScreen) != 0) return 0;
+    NSScreen *scr = g_bp_win.screen ?: NSScreen.mainScreen;
+    if (!scr) return 0;
+    CGFloat scale = scr.backingScaleFactor;
+    if (scale <= 0) scale = 1;
+    CGSize points = CGSizeMake((CGFloat)g_bp_w / scale, (CGFloat)g_bp_h / scale);
+    NSSize cur = g_bp_win.contentView.bounds.size;
+    if (fabs(cur.width - points.width) > 0.5 || fabs(cur.height - points.height) > 0.5)
+        [g_bp_win setContentSize:NSSizeFromCGSize(points)];
+    [(DmGameView *)g_bp_win.contentView fitDrawable];
+    NSRect vis = scr.visibleFrame, fr = g_bp_win.frame;
+    if (NSWidth(fr) > NSWidth(vis) || NSHeight(fr) > NSHeight(vis))
+        LOG("front end: native-resolution bypass window %.0fx%.0f pt is larger than the screen's visible %.0fx%.0f (preset %dx%d, scale %.2f)",
+            NSWidth(fr), NSHeight(fr), NSWidth(vis), NSHeight(vis), g_bp_w, g_bp_h, (double)scale);
+    return 1;
+}
+static void bp_reject(NSWindow *win, int was, const char *why) {   // the bypass cannot hold: state +0xB4 back to 0, the stock path, with the reason in the log
+    (void)win; (void)was;
+    if (dm_fps_state) { uint32_t off = 0; memcpy(dm_fps_state + 0xB4, &off, sizeof off); }
+    g_bp_on = 0; g_bp_fixed = 0;
+    LOG("front end: native-resolution bypass off (%s); using the stock path", why);
+}
+static int bp_force_internal(void) {   // force the preset at boot: publish mode (+0xB4); the loader owns +0x10 (DM_RENDER_SCALE). Windowed sizes the window in points to preset / scale so the backing lands on the preset; fullscreen leaves the drawable to the view so DM_PRESENT_UPSCALE (metalfx) upscales the preset to the screen
+    if (!dm_fps_state || !g_layer) return 0;
+    uint32_t mode = (uint32_t)g_bp_mode; memcpy(dm_fps_state + 0xB4, &mode, sizeof mode);
+    const char *fs = getenv("DM_FULLSCREEN");   // boot-time fullscreen is asked asynchronously below, so g_fullscreen / the style mask are not set yet when forcing
+    if (g_fullscreen || (g_bp_win.styleMask & NSWindowStyleMaskFullScreen) != 0 || (fs && strcmp(fs, "0"))) {
+        g_bp_on = 1; g_bp_fixed = 1;
+        LOG("front end: native-resolution bypass on (%dx%d, SWX_NATIVE_RES); fullscreen leaves the drawable to the view, upscaled per DM_PRESENT_UPSCALE", g_bp_w, g_bp_h);
+        return 1;
+    }
+    g_bp_on = 1; g_bp_fixed = 1;
+    bp_enforce_windowed();
+    NSScreen *scr = g_bp_win.screen ?: NSScreen.mainScreen;
+    double scale = scr ? scr.backingScaleFactor : 1;
+    if (scale <= 0) scale = 1;
+    LOG("front end: native-resolution bypass on (%dx%d, SWX_NATIVE_RES); windowed %.0fx%.0f pt (scale %.2f, backing %dx%d, no upscale)",
+        g_bp_w, g_bp_h, g_bp_w / scale, g_bp_h / scale, scale, g_bp_w, g_bp_h);
+    LOG("front end: native-resolution bypass forced window to %.0fx%.0f pt", g_bp_w / scale, g_bp_h / scale);
+    return 1;
+}
+static void bp_screen_changed(void) {   // on a screen change or a fullscreen transition: fullscreen follows the view, a window keeps the preset's backing size
+    if (!g_bp_on || !g_bp_fixed || g_bp_trans) return;   // not bypassing, or a transition is in flight (its did-enter / did-exit runs this again)
+    if (!g_bp_win) return;
+    NSScreen *scr = g_bp_win.screen;
+    NSUInteger now = scr ? [scr.deviceDescription[@"NSScreenNumber"] unsignedIntValue] : 0;
+    if (now != g_bp_screen) g_bp_screen = now;   // the window moved to another screen
+    if (g_fullscreen) [(DmGameView *)g_bp_win.contentView fitDrawable];   // the drawable follows the view
+    else bp_enforce_windowed();   // windowed: preset / scale pt so the backing lands on the preset
+}
