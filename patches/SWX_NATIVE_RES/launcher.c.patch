# SWX_NATIVE_RES group (launcher.c.patch): accept saved render-scale percent numerically
# verify: dm/mac/launcher.c:DM_RENDER_SCALE
diff --git a/dm/mac/launcher.c b/dm/mac/launcher.c
index 0cd452dd..096b8469 100644
--- a/dm/mac/launcher.c
+++ b/dm/mac/launcher.c
@@ -88,6 +88,8 @@ static void env_file(const char *path) {   // KEY=VALUE lines, # starts a commen
     fclose(f);
 }
 
+static int rule_env(CFTypeRef rule, char *env, size_t n);   // a rule's variable name (defined below)
+
 static int saved_accepted(CFDictionaryRef rule, CFStringRef v, const char *s) {   // a saved choice this build still offers: one of its values, or a number in its range
     CFTypeRef values = CFDictionaryGetValue(rule, CFSTR("values"));
     if (values && CFGetTypeID(values) == CFArrayGetTypeID()) {
@@ -95,6 +97,20 @@ static int saved_accepted(CFDictionaryRef rule, CFStringRef v, const char *s) {
             CFTypeRef o = CFArrayGetValueAtIndex(values, i);
             if (CFGetTypeID(o) == CFStringGetTypeID() && CFStringCompare(o, v, 0) == kCFCompareEqualTo) return 1;
         }
+        // A saved render-scale percent from the slider era (1.00 for 1.0): numeric equality, DM_RENDER_SCALE only (no other row compares saved numbers to its options)
+        char env[128];
+        if (rule_env(rule, env, sizeof env) && !strcmp(env, "DM_RENDER_SCALE")) {
+            char *end; double x = strtod(s, &end);
+            if (*s && !isspace((unsigned char)*s) && !strpbrk(s, "xX") && !*end && x == x) {   // as Setting.accepts (LauncherSettings.swift): no leading space, no hex, no NaN
+                for (CFIndex i = 0; i < CFArrayGetCount(values); i++) {
+                    CFTypeRef o = CFArrayGetValueAtIndex(values, i); char t[64];
+                    if (CFGetTypeID(o) == CFStringGetTypeID() && CFStringGetCString(o, t, sizeof t, kCFStringEncodingUTF8) && *t) {
+                        char *e2; double y = strtod(t, &e2);
+                        if (!*e2 && y == x) return 1;
+                    }
+                }
+            }
+        }
         return 0;
     }
     CFTypeRef lo = CFDictionaryGetValue(rule, CFSTR("min")), hi = CFDictionaryGetValue(rule, CFSTR("max")); double l, h;
