+    func normalizedSaved(_ s: Setting, _ v: String) -> String? {   // a saved choice the game still offers: a render-scale percent compares as a number (the slider wrote 1.00 for 1.0)
+        if s.env == "DM_RENDER_SCALE", s.kind == "choice" {
+            guard !v.contains(where: { $0 == "x" || $0 == "X" }), let n = Double(v), n.isFinite else { return nil }   // no hex: launcher.c's check agrees
+            return s.options?.first { !$0.isEmpty && Double($0[0]) == n }?[0]
+        }
+        return s.accepts(v) ? v : nil
+    }
+    func lockedChoicePercent(_ s: Setting) -> String? {   // a fixed render-scale choice as a percent (the Mac window shows it instead of the picker): nil when it is no such row
+        guard s.env == "DM_RENDER_SCALE", s.kind == "choice", fixed.contains(s.env),
+              let n = Double(values[s.env] ?? s.def), n.isFinite else { return nil }
+        return "\(Int((n * 100).rounded())) %"
+    }
     var changed: Bool { settings.contains { !fixed.contains($0.env) && !$0.isDefault(values[$0.env] ?? $0.def) } }
 
