--- /dev/null	2026-11-16 10:17:44
+++ b/dm/gfx/nvn/swx_keepalive.m	2026-11-16 10:17:40
@@ -0,0 +1,114 @@
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <sys/time.h>
+#import <unistd.h>
+#import <stdatomic.h>
+#import <TargetConditionals.h>
+
+// SWX GPU keep-alive: hold the GPU clock up between the game's submissions.
+//
+// Why: Apple lowers the GPU clock when it idles part of each frame, and this
+// game waits for each frame before it submits the next, so its GPU work ran
+// ~25% slower with idle gaps than back to back (standalone measurement:
+// same compute 10.9 ms back to back, 16.8 ms with 10 ms gaps). A thread keeps
+// up to one short spin kernel (~1 ms, self-calibrated) in flight on its own
+// command queue while the game is submitting frames, so the clock never sees
+// the idle that triggers the downclock. Costs about one GPU core and power;
+// it stops when no submission happened for 100 ms.
+//
+// Design notes:
+// - Own device reference and command queue: never touches the game's queues,
+//   encoders or fences, so game GPU-time accounting (per-fence GPUStart/End)
+//   and the frame step are unaffected. Only reads one counter.
+// - Starts on the first presented frame (called from mtl_ub_present), so
+//   unit tests, the prebuild tool and headless captures never start it.
+// - No early-exit stop word in v1: kernels are capped around 1 ms on a
+//   separate queue, so a game submission never waits behind one.
+// - Env: SWX_GPU_KEEPALIVE=0 turns it off (default on macOS, off on iOS
+//   where the spinning heats the phone); SWX_GPU_KEEPALIVE_US=100..1000
+//   sets the kernel target length (default 1000 us).
+
+extern int swx_gpu_inflight(void);   // nvn_mtl.m: game submissions committed and not yet reported back
+
+static _Atomic int g_started, g_dead;
+static _Atomic uint64_t g_n, g_us, g_max_us;
+static _Atomic int g_target_us = 1000;
+
+static uint64_t now_ns(void) {
+    struct timeval tv; gettimeofday(&tv, NULL);
+    return (uint64_t)tv.tv_sec * 1000000000ull + (uint64_t)tv.tv_usec * 1000ull;
+}
+
+static int keepalive_on(void) {
+    const char *e = getenv("SWX_GPU_KEEPALIVE");
+#if TARGET_OS_IPHONE
+    return e && atoi(e) != 0;
+#else
+    return !e || atoi(e) != 0;
+#endif
+}
+
+void swx_keepalive_start(void) {
+    if (atomic_exchange(&g_started, 1)) return;
+    if (!keepalive_on()) return;
+    const char *us = getenv("SWX_GPU_KEEPALIVE_US");
+    int v = us ? atoi(us) : 0;
+    if (v >= 100 && v <= 1000) atomic_store(&g_target_us, v);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+        if (!dev) { atomic_store(&g_dead, 1); return; }
+        NSError *err = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:
+            @"#include <metal_stdlib>\n"
+            "using namespace metal;\n"
+            "kernel void swx_keep(device float *slot [[buffer(0)]], constant uint &iters [[buffer(1)]], uint i [[thread_position_in_grid]]) {"
+            " float x = slot[i] + (float)i;"
+            " for (uint n = 0; n < iters; ++n) { x = fma(x, 1.0000001f, 0.5f); }"
+            " slot[i] = x; }\n" options:nil error:&err];
+        id<MTLFunction> fn = lib ? [lib newFunctionWithName:@"swx_keep"] : nil;
+        id<MTLComputePipelineState> ps = fn ? [dev newComputePipelineStateWithFunction:fn error:&err] : nil;
+        id<MTLCommandQueue> q = ps ? [dev newCommandQueue] : nil;
+        id<MTLBuffer> buf = ps ? [dev newBufferWithLength:4096 options:MTLResourceStorageModePrivate] : nil;
+        if (!ps || !q || !buf) {
+            fprintf(stderr, "[swx-keepalive] spinner unavailable: %s\n", err ? err.localizedDescription.UTF8String : "no pipeline/queue/buffer");
+            atomic_store(&g_dead, 1);
+            return;
+        }
+        fprintf(stderr, "[swx-keepalive] on: short spin kernels (~%d us) on their own queue while the game submits (SWX_GPU_KEEPALIVE=0 turns it off)\n", atomic_load(&g_target_us));
+        dispatch_semaphore_t sem = dispatch_semaphore_create(1);
+        __block uint32_t iters = 40000;   // ~1 ms at full clock; self-calibrated below
+        uint64_t last_busy = 0;
+        for (;;) @autoreleasepool {
+            if (atomic_load(&g_dead)) return;
+            uint64_t now = now_ns();
+            if (swx_gpu_inflight() > 0) { last_busy = now; usleep(2000); continue; }
+            if (!last_busy || now - last_busy > 100000000ull) { usleep(10000); continue; }   // the game is not rendering
+            dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
+            if (swx_gpu_inflight() > 0) { last_busy = now_ns(); dispatch_semaphore_signal(sem); usleep(2000); continue; }
+            int target_us = atomic_load(&g_target_us);
+            uint32_t n = iters;
+            id<MTLCommandBuffer> cb = [q commandBuffer];
+            id<MTLComputeCommandEncoder> ce = [cb computeCommandEncoder];
+            [ce setComputePipelineState:ps];
+            [ce setBuffer:buf offset:0 atIndex:0];
+            [ce setBytes:&n length:4 atIndex:1];
+            [ce dispatchThreads:MTLSizeMake(32, 1, 1) threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+            [ce endEncoding];
+            [cb addCompletedHandler:^(id<MTLCommandBuffer> c) {
+                double ms = (c.GPUEndTime - c.GPUStartTime) * 1e3;
+                if (ms > 0.01) {
+                    atomic_fetch_add(&g_n, 1);
+                    atomic_fetch_add(&g_us, (uint64_t)(ms * 1e3));
+                    uint64_t mx = atomic_load(&g_max_us), us = (uint64_t)(ms * 1e3);
+                    while (us > mx && !atomic_compare_exchange_weak(&g_max_us, &mx, us)) {}
+                    double k = (target_us * 0.001) / ms;
+                    if (k > 2) k = 2; if (k < 0.5) k = 0.5;
+                    double m = n * k;
+                    iters = m < 2000 ? 2000 : m > 400000 ? 400000 : (uint32_t)m;
+                }
+                dispatch_semaphore_signal(sem);
+            }];
+            [cb commit];
+        }
+    });
+}
