+// ---- SWX_FIDELITYFX_CAS=1: AMD CAS sharpen-only on BOTW 1.9.0's 3D scene (opt-in) ----
+// The anchor is the FXAA/upscale draw (fs key bd7ffdd435c6c3bc with vs 5e9f57168d89a543): a fullscreen triangle
+// (prim 4, 3 verts, indexed) into a single RGB10A2Unorm 2D canvas, sampling a same-format 2D scene texture,
+// no blending, full viewport (PASSDUMP-confirmed 2026-11-2x: exactly one such draw per gameplay frame; no such draw
+// with the inventory open, so menus never trigger). Before that draw, the scene runs through fs_cas into a private
+// scratch texture of the same format and size, and only this draw's scene binding is swapped to it (UVs, sampler,
+// other readers unchanged); a reused scratch while the config holds, retired on change. Anything else (another
+// format, an oversized scene, HUD layouts) leaves the draw on the original texture. SWX_FIDELITYFX_CAS absent or 0: zero passes.
+#define FXCAS_FS "bd7ffdd435c6c3bc"
+#define FXCAS_VS "5e9f57168d89a543"
+static float fxcas_sharpness(void) { static float v = -2.0f; if (v == -2.0f) { const char *e = getenv("SWX_FIDELITYFX_CAS_SHARPNESS"); v = 0.25f;
+    if (e) { char *end = NULL; float f = strtof(e, &end); if (end == e || *end || !(f >= 0.0f && f <= 1.0f)) MLOG("[RED] SWX_FIDELITYFX_CAS_SHARPNESS=%s: must be 0 to 1; using 0.25", e); else v = f; } } return v; }
+static int fxcas_on(void) { static int v = -2; if (v == -2) { const char *e = getenv("SWX_FIDELITYFX_CAS"); v = (e && atoi(e)) ? 1 : 0;
+    if (v) MLOG("SWX_FIDELITYFX_CAS=1: AMD CAS sharpen-only (sharpness %.2f) on BOTW's 3D scene before its composite draw", fxcas_sharpness()); } return v; }
+static id<MTLTexture> fxcas_tex = nil; static uint64_t fxcas_scene_ser = 0; static int fxcas_armed = 0;
+static const p_draw *fxcas_dw = NULL; static const p_draw_idx *fxcas_di = NULL;
+static unsigned long long fxcas_n = 0;
+static id<MTLTexture> fxcas_run(id<MTLTexture> src) {
+    static id<MTLTexture> scratch = nil; static NSUInteger sw = 0, sh = 0; static MTLPixelFormat spf = 0;
+    static NSMutableDictionary<NSNumber *, id<MTLRenderPipelineState>> *pso; static id<MTLFunction> vf, ff;
+    static id<MTL4ArgumentTable> at; static id<MTLBuffer> sbuf; static int failed;
+    if (failed || !src) return nil;
+    if (!vf) {
+        NSError *e = nil; id<MTLLibrary> lib = host_lib("fxcas", &e);
+        vf = [lib newFunctionWithName:@"vs_cas"]; ff = [lib newFunctionWithName:@"fs_cas"];
+        MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new]; ad.maxTextureBindCount = 1; ad.maxBufferBindCount = 1;
+        at = rec_table([g_dev newArgumentTableWithDescriptor:ad error:&e]);
+        sbuf = [g_dev newBufferWithLength:4 options:MTLResourceStorageModeShared];
+        if (sbuf) *(float *)sbuf.contents = fxcas_sharpness();
+        if (!vf || !ff || !at || !sbuf) { failed = 1; MLOG("[RED] cannot create the FXCAS pipelines: %s", e.localizedDescription.UTF8String); return nil; }
+        pso = [NSMutableDictionary dictionary];
+    }
+    if (!scratch || sw != src.width || sh != src.height || spf != src.pixelFormat) {
+        if (scratch) { res_remove(scratch); defer_obj_release(scratch); }
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:src.pixelFormat width:src.width height:src.height mipmapped:NO];
+        d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead; d.storageMode = MTLStorageModePrivate;
+        scratch = [g_dev newTextureWithDescriptor:d]; sw = src.width; sh = src.height; spf = src.pixelFormat;
+        if (!scratch) { MLOG("[RED] FXCAS: cannot make the %lux%lu scratch texture", (unsigned long)sw, (unsigned long)sh); return nil; }
+        res_add(scratch);
+    }
+    NSNumber *pk = @(src.pixelFormat);
+    id<MTLRenderPipelineState> ps = pso[pk];
+    if (!ps) {
+        MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new]; pd.vertexFunction = vf; pd.fragmentFunction = ff;
+        pd.colorAttachments[0].pixelFormat = src.pixelFormat;
+        NSError *e = nil; ps = [g_dev newRenderPipelineStateWithDescriptor:pd error:&e];
+        if (!ps) { MLOG("[RED] FXCAS: cannot make the pipeline for format %lu: %s", (unsigned long)src.pixelFormat, e.localizedDescription.UTF8String); return nil; }
+        pso[pk] = ps;
+    }
+    rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+    MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
+    MTLRenderPassAttachmentDescriptor *a = rp.colorAttachments[0];
+    a.texture = scratch; a.loadAction = MTLLoadActionDontCare; a.storeAction = MTLStoreActionStore;
+    ser_gate(); id<MTL4RenderCommandEncoder> en = enc_r_begin(rp);
+    [en setArgumentTable:at atStages:MTLRenderStageFragment];
+    [at setTexture:src.gpuResourceID atIndex:0];
+    [at setAddress:sbuf.gpuAddress atIndex:0];
+    [en setViewport:(MTLViewport){0, 0, (double)sw, (double)sh, 0, 1}];
+    [en setScissorRect:(MTLScissorRect){0, 0, (NSUInteger)sw, (NSUInteger)sh}];
+    [en setRenderPipelineState:ps]; [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; enc_r_end(en);
+    args_dirty_all(); g_pso_dirty = g_dss_dirty = 1;
+    return scratch;
+}
+// Before the anchor draw: sharpen the scene it is about to sample and arm the one-shot binding swap (encode_args_).
+static void fxcas_try(const p_draw *dw, const p_draw_idx *di) {
+    if (fxcas_armed && (dw != fxcas_dw || di != fxcas_di)) {   // armed for another draw that never encoded (discard, cull, empty scissor): release it, the next encode is fresh
+        fxcas_armed = 0; fxcas_tex = nil; fxcas_scene_ser = 0; fxcas_dw = NULL; fxcas_di = NULL; args_dirty(1);
+    }
+    if (fxcas_armed) return;
+    int prim = dw ? dw->prim : di ? di->prim : -1, count = dw ? (int)dw->count : di ? (int)di->count : -1;
+    if (prim != 4 || count != 3 || !di) return;
+    NvProg *pr = S.prog ? prog_get(S.prog) : nil;
+    if (!pr || !pr->sh[0] || !pr->sh[0]->key || !pr->sh[1] || !pr->sh[1]->key) return;
+    if (strncmp(pr->sh[1]->key, FXCAS_FS, 16) || strncmp(pr->sh[0]->key, FXCAS_VS, 16)) return;
+    if (R.rt.n != 1 || !R.rt.color[0] || (S.color.blend_en & 1)) return;
+    id<MTLTexture> ct = tex_mtl(R.rt.color[0]);
+    if (!ct || ct.textureType != MTLTextureType2D || ct.sampleCount != 1 || ct.pixelFormat != MTLPixelFormatRGB10A2Unorm) return;
+    if (S.has_vp && (S.vp[0][0] != 0 || S.vp[0][1] != 0 || S.vp[0][2] != (float)ct.width || S.vp[0][3] != (float)ct.height)) return;
+    int tid = (int)(bound_tex(1, 0) & 0xfffff);
+    if (tid <= 0) return;
+    void *tv = NULL; uint64_t sser = 0;
+    __unsafe_unretained id<MTLTexture> st = nil;
+    os_unfair_lock_lock(&g_rmu);   // the registration tables may be grown or rewritten by the game thread (encode_args_ convention); released before fxcas_run, which encodes
+    if (tid < g_ntreg && g_treg[tid].ok) {
+        tex_fast_rid(tid, &tv);
+        st = (__bridge id<MTLTexture>)tv;
+        int snap = st ? fb_snapshot_slot(1, st) : -1; if (snap >= 0) st = g_fb_use[snap];
+        sser = g_treg[tid].t.serial;
+    }
+    os_unfair_lock_unlock(&g_rmu);
+    if (!st || st.textureType != MTLTextureType2D || st.sampleCount != 1 || st.pixelFormat != ct.pixelFormat || !sser || sser == R.rt.color[0]->serial) return;
+    if (st.width > ct.width || st.height > ct.height) return;
+    if (st.swizzle.red != MTLTextureSwizzleRed || st.swizzle.green != MTLTextureSwizzleGreen || st.swizzle.blue != MTLTextureSwizzleBlue || st.swizzle.alpha != MTLTextureSwizzleAlpha) return;
+    id<MTLTexture> sharp = fxcas_run(st);
+    if (!sharp) return;
+    fxcas_scene_ser = sser; fxcas_tex = sharp; fxcas_dw = dw; fxcas_di = di; fxcas_armed = 1; args_dirty(1);
+    if (!fxcas_n++ || fxcas_n % 3600 == 0) MLOG("[fxcas] BOTW scene %lux%lu sharpened before its composite draw (%llu frames)", (unsigned long)st.width, (unsigned long)st.height, fxcas_n);
 }
