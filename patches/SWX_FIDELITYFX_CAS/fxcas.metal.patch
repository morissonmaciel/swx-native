# SWX_FIDELITYFX_CAS group (fxcas.metal.patch): new AMD CAS Metal shader (fs_cas).
# verify: dm/gfx/msl/fxcas.metal:fs_cas
# See SWX_FIDELITYFX_CAS/fidelityfx_cas.md.
--- /dev/null	2026-11-19 23:34:59
+++ b/dm/gfx/msl/fxcas.metal	2026-11-19 23:32:22
@@ -0,0 +1,34 @@
+// AMD FidelityFX CAS, sharpen-only (MIT, Copyright (c) Advanced Micro Devices, Inc.): port of Savage Wind's
+// cas.frag (runtime/nvn/vulkan/shaders.c) to Metal. Runs on BOTW's 3D scene right before the draw that composites
+// it onto the canvas; the draw then samples the sharpened copy (nvn_mtl.m SWX_FIDELITYFX_CAS).
+#include <metal_stdlib>
+using namespace metal;
+struct V { float4 p [[position]]; };
+vertex V vs_cas(uint id [[vertex_id]]) { float2 uv = float2((id << 1) & 2, id & 2); V o; o.p = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); return o; }
+// Default 0.25 intensity (SWX_FIDELITYFX_CAS=1), overridable via SWX_FIDELITYFX_CAS_SHARPNESS (0..1): 3x3 taps clamped to the texture (valid under DRS), alpha passes through.
+fragment float4 fs_cas(V in [[stage_in]], texture2d<float> t [[texture(0)]], constant float &sharpness [[buffer(0)]]) {
+    int2 ip = int2(in.p.xy);
+    int2 lo = int2(0), hi = int2(t.get_width(), t.get_height()) - 1;
+    float3 a = t.read(uint2(clamp(ip + int2(-1, -1), lo, hi))).rgb;
+    float3 b = t.read(uint2(clamp(ip + int2( 0, -1), lo, hi))).rgb;
+    float3 c = t.read(uint2(clamp(ip + int2( 1, -1), lo, hi))).rgb;
+    float3 d = t.read(uint2(clamp(ip + int2(-1,  0), lo, hi))).rgb;
+    float3 f = t.read(uint2(clamp(ip + int2( 1,  0), lo, hi))).rgb;
+    float3 g = t.read(uint2(clamp(ip + int2(-1,  1), lo, hi))).rgb;
+    float3 h = t.read(uint2(clamp(ip + int2( 0,  1), lo, hi))).rgb;
+    float3 i = t.read(uint2(clamp(ip + int2( 1,  1), lo, hi))).rgb;
+    float4 e4 = t.read(uint2(clamp(ip, lo, hi)));
+    float3 e = e4.rgb;
+    float3 mn = min(min(min(d, e), min(f, b)), h);
+    float3 mn2 = min(min(min(mn, a), min(c, g)), i);
+    mn += mn2;
+    float3 mx = max(max(max(d, e), max(f, b)), h);
+    float3 mx2 = max(max(max(mx, a), max(c, g)), i);
+    mx += mx2;
+    float3 amp = clamp(min(mn, 2.0 - mx) / max(mx, float3(1.0 / 65536.0)), 0.0, 1.0);
+    amp = sqrt(amp);
+    float peak = -1.0 / mix(8.0, 5.0, sharpness);
+    float w = amp.g * peak;
+    float3 r = (b * w + d * w + f * w + h * w + e) / (1.0 + 4.0 * w);
+    return float4(max(r, 0.0), e4.a);
+}
