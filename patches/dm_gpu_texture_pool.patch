 static size_t g_up_staging_bytes;
 #define UP_BATCH_BYTES (128u * 1024u * 1024u)
+// SWX_GPU_TEXTURE_POOL=1: unified texture-loading improvements (default off).
+// 6x32MB private blocks stay resident across batches; take = find free (busy
+// bit clear) instead of per-batch newBuffer+res_add; retire = clear busy bit
+// on upload completion instead of res_remove. Slice 2 pre-reserve: resident
+// pool blocks add no new bytes, so the 128 MB batch cap counts the texture's
+// own bytes instead of whole-block sizes; stock keeps the worst-case block cost.
+// One-offs (>32MB, pool exhausted) keep today's path. Slot retention, commit
+// and fence ordering are untouched.
+#define SWX_UP_POOL_N 6
+static __strong id<MTLBuffer> g_swx_pool[SWX_UP_POOL_N];
+static _Atomic uint64_t g_swx_pool_busy;
+static _Atomic uint64_t g_swx_pool_hits, g_swx_pool_miss;
+static unsigned g_swx_batch_pool; static int g_up_block_pooled;
+static int swx_texture_pool_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("SWX_GPU_TEXTURE_POOL"); v = e && atoi(e) != 0;
+        if (v) MLOG("SWX_GPU_TEXTURE_POOL=1: unified texture staging (resident 6x32MB pool + pre-reserve); =0 keeps stock path"); }
+    return v;
+}
+static id<MTLBuffer> swx_pool_take(unsigned *idx) {   // a free 32MB block, or nil (pool exhausted)
+    for (unsigned i = 0; i < SWX_UP_POOL_N; i++) {
+        uint64_t bit = 1ull << i;
+        if (!(atomic_fetch_or(&g_swx_pool_busy, bit) & bit)) {
+            if (!g_swx_pool[i]) { g_swx_pool[i] = [g_dev newBufferWithLength:UP_BLOCK_SIZE options:MTLResourceStorageModePrivate]; if (!g_swx_pool[i]) { atomic_fetch_and(&g_swx_pool_busy, ~bit); return nil; } res_add(g_swx_pool[i]); }
+            atomic_fetch_add(&g_swx_pool_hits, 1); *idx = i; return g_swx_pool[i];
+        }
+    }
+    atomic_fetch_add(&g_swx_pool_miss, 1);
+    return nil;
+}
 
 
