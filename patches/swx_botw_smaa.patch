+// fullscreen copy/resolve draw keeps running: the hook filters its source
+// texture (fragment stage texture slot 0, bound_tex(1,0)/tex_by_id; never a
+// snapshot of the destination) through three fullscreen passes (edge into
+// RG8Unorm, blend weights into RGBA8Unorm, neighbourhood blend) into a
+// temporary compatible with the source (same format, dimensions and colour
+// interpretation), then registers it as this draw's binding only
+// (g_fb_src/g_fb_use, the one-draw substitution fb_prepare uses; encode_args
+// honours it on the direct path and on the recorder's replay). The sampler,
+// coordinates, format and the game's RGB-only channel mask stay the draw's
+// own. SMAA reference: https://github.com/iryoku/smaa (MIT License; see
+// dm/gfx/msl/smaa.metal).
+// Interface: SWX_AA=smaa arms it, absent or =0 keeps the original, any other
+// value keeps the original with a single warning; read once at launch. The
+// installer leaves it absent (wrapper/main.py): the harness sets it per run.
+// Anchor: the full fragment-shader key of the final copy/resolve
+// (DM_NVN_PASSDUMP fs=...); Etapa 0 fills it in. Empty: the hook keeps the
+// original. With a key, the draw whose FS (and VS, when the same FS appears
+// in more than one draw) matches is filtered. Any failure leaves the
+// original draw with the original source.
+// Follow-up (not implemented here): refs/mac-nativegames/games/totk/
+// third_party/d2r_gfx/gfx/nvn/botw_finish.h:70-100 validates a full draw (2D
+// source, source!=destination, no blend, RGB-only mask, integral
+// viewport/scissor) and composes texel-for-texel or bilinear RGB-only;
+// cite it before changing this hook's policy.
+static int swx_aa_smaa_on(void) {
+    static int v = -2;
+    if (v == -2) {
+        const char *e = getenv("SWX_AA");
+        if (!e || !*e || !strcmp(e, "0")) v = 0;
+        else if (!strcmp(e, "smaa")) { v = 1; MLOG("SWX_AA=smaa: SMAA 1x armed (anchor fs=bd7ffdd435c6c3bc)"); }
+        else { v = 0; MLOG("[RED] SWX_AA=%s unknown (want smaa or 0): keeping the original draws", e); }
+    }
+    return v;
+}
+// Etapa 0 (captured 2026-11-20, PASSDUMP F3115-3117, SWX_NATIVE_RES=1440p):
+// the fullscreen 2560x1440 composite (scene -> canvas, blend=0, wm=0x7
+// RGB-only, integral viewport; 1x/frame, unique VS pairing). Source is the
+// 2D scene (FXCAS-sharpened when SWX_FXCAS=1), never a snapshot of the
+// destination canvas.
+static const char k_swx_smaa_fs[] = "bd7ffdd435c6c3bc";
+static const char k_swx_smaa_vs[] = "5e9f57168d89a543";
+static int swx_smaa_wanted(NvProg *pr) {
+    if (!swx_aa_smaa_on()) return 0;
+    if (!k_swx_smaa_fs[0] || !pr || !pr->sh[1]) return 0;
+    if (strncmp(pr->sh[1]->key, k_swx_smaa_fs, 16)) return 0;
+    if (k_swx_smaa_vs[0] && (!pr->sh[0] || strncmp(pr->sh[0]->key, k_swx_smaa_vs, 16))) return 0;
+    return 1;
+}
