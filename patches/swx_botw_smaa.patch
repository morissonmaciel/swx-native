# SWX_AA=smaa: SMAA 1x binding-swap for BOTW 1.9.0 on macOS. The anchored
# fullscreen copy/resolve draw keeps running: the hook filters its source
# texture (fragment stage texture slot 0, bound_tex(1,0)/tex_by_id; never a
# snapshot of the destination) through three fullscreen passes (edge into
# RG8Unorm, blend weights into RGBA8Unorm, neighbourhood blend) into a
# temporary compatible with the source (same format, dimensions and colour
# interpretation), then registers it as this draw's binding only
# (g_fb_src/g_fb_use, the one-draw substitution fb_prepare uses; encode_args
# honours it on the direct path and on the recorder's replay). The sampler,
# coordinates, format and the game's RGB-only channel mask stay the draw's
# own. Interface: SWX_AA=smaa arms it, absent or =0 keeps the original,
# unknown keeps the original with a single warning; read once at launch; the
# installer leaves it absent (harness sets it per run). Anchor: the full FS
# key, now filled (Etapa 0, 2026-11-20): fs=bd7ffdd435c6c3bc +
# vs=5e9f57168d89a543 (the fullscreen 2560x1440 composite, 1x/frame,
# PASSDUMP F3115-3117). The VS key is pinned too (unique pairing observed).
# With a key, the draw whose FS (and VS) matches is filtered. Empty would
# keep the original; any failure leaves the original draw with the original source.
# LUTs: AreaTex RG8Unorm 160x560 + SearchTex R8Unorm 64x16, original bytes
# (refs/mac-nativegames/games/totk/third_party/smaa at 71c806a838bdd7d, MIT
# License preserved in dm/gfx/msl/smaa.metal), uploaded once into immutable
# textures and reused across frames and scales. Ordering through the core
# Metal 4 primitives (enc_r_begin/end barriers); recorder-safe (enc_r_* +
# rec_table, as copy_t2t_draw). Intermediates reuse only on confirmed GPU
# completion (slot ring vs g_done). Follow-up (not implemented here):
# refs/mac-nativegames/games/totk/third_party/d2r_gfx/gfx/nvn/
# botw_finish.h:70-100 validates a full draw (2D source, source!=destination,
# no blend, RGB-only mask, integral viewport/scissor) and composes
# texel-for-texel or bilinear RGB-only; cite it before changing this hook's
# policy.
# verify: dm/gfx/msl/smaa.metal:smaa_weights
# verify: dm/gfx/msl/smaa.metal
# verify: dm/gfx/nvn/nvn_mtl.m:swx_smaa_filter
# verify: dm/gfx/nvn/nvn_mtl.m:k_swx_smaa_fs
# verify: dm/gfx/nvn/nvn_mtl.m:SWX_AA=smaa
# verify: dm/gfx/nvn/nvn_mtl.m:k_swx_smaa_area
--- /dev/null
+++ b/dm/gfx/msl/smaa.metal
@@ -0,0 +1,48 @@
+// SMAA 1x for swx-native (BOTW 1.9.0 on macOS): three fullscreen passes
+// (edge detection, blend-weight solve, neighbourhood blend), driven by
+// nvn_mtl.m (SWX_AA=smaa) as a binding swap: the matched draw's source
+// texture (fragment stage texture slot 0) is filtered into a compatible
+// temporary, and the original draw runs with it. Built with the host's
+// shaders (dm/gfx/tools/host_msl.py, wildcard dm/gfx/msl/*.metal):
+// host_msl.m loads it by name.
+// SMAA reference: https://github.com/iryoku/smaa (MIT License). The LUT byte
+// tables (AreaTex 160x560 RG8, SearchTex 64x16 R8) live in nvn_mtl.m. Until
+// the anchor is set the hook keeps the original draws and these kernels
+// never encode.
+#include <metal_stdlib>
+using namespace metal;
+struct V { float4 p [[position]]; float2 uv; };
+vertex V smaa_vs(uint id [[vertex_id]]) { float2 uv = float2((id << 1) & 2, id & 2); V o; o.p = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); o.uv = uv; return o; }
+// p[0] = (1/w, 1/h, w, h). Luma edge mask (SMAA_THRESHOLD placeholder: Etapa 0 tunes from the reference).
+fragment float2 smaa_edge(V in [[stage_in]], texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]], constant float4 *p [[buffer(0)]]) {
+  float2 texel = p[0].xy;
+  float3 w = float3(0.299, 0.587, 0.114);
+  float c = dot(t.sample(s, in.uv).rgb, w);
+  float l = dot(t.sample(s, in.uv - float2(texel.x, 0.0)).rgb, w);
+  float u = dot(t.sample(s, in.uv - float2(0.0, texel.y)).rgb, w);
+  return float2(step(0.1, abs(c - l)), step(0.1, abs(u - c)));
+}
+// Blend weights from the edge mask and the Area/Search LUTs (Etapa 0: the full
+// SMAA solve with coordinated SearchTex/AreaTex lookups; the hook is inert until then).
+fragment float4 smaa_weights(V in [[stage_in]], texture2d<float> e [[texture(0)]], texture2d<float> area [[texture(1)]], texture2d<float> search [[texture(2)]], sampler s [[sampler(0)]], constant float4 *p [[buffer(0)]]) {
+  (void)p;
+  float2 ed = e.sample(s, in.uv).rg;
+  float2 aw = area.sample(s, in.uv).rg;
+  float q = search.sample(s, in.uv).r;
+  return float4(ed * aw, q, 0.0);
+}
+// Neighbourhood blend of the source into the compatible temporary. Colour is
+// filtered, alpha preserved.
+fragment float4 smaa_blend(V in [[stage_in]], texture2d<float> src [[texture(0)]], texture2d<float> w [[texture(1)]], sampler s [[sampler(0)]], constant float4 *p [[buffer(0)]]) {
+  float2 texel = p[0].xy;
+  float4 c = src.sample(s, in.uv);
+  float4 wq = w.sample(s, in.uv);
+  float wsum = wq.r + wq.g;
+  float3 rgb = c.rgb;
+  if (wsum > 0.0) {
+    float3 ch = src.sample(s, in.uv + float2(texel.x, 0.0)).rgb;
+    float3 cv = src.sample(s, in.uv + float2(0.0, texel.y)).rgb;
+    rgb = (c.rgb + ch * wq.r + cv * wq.g) / (1.0 + wsum);
+  }
+  return float4(rgb, c.a);
+}
