# SWX: split upload batches by texture count as well as by bytes (area-entry bursts).
# verify: dm/gfx/nvn/nvn_mtl.m:swx_upload_split_max
# verify: dm/gfx/nvn/nvn_mtl.m:g_up_batch_tex += 1;
# See docs/texture_streaming_hitches.md sections 1a and 5.
# Default OFF since Gate 1 (2026-11-16): +13 ms submit on the 237-texture
# burst with the split on; opt in with SWX_UPLOAD_SPLIT=1 (or MAX_TEX).
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -3253,6 +3253,26 @@
 // texture larger than the budget gets its own block (uploads are not tiled here).
 static size_t g_up_staging_bytes;
 #define UP_BATCH_BYTES (128u * 1024u * 1024u)
+
+// SWX: split an upload batch after this many textures as well as after 128 MB, so one
+// area-entry burst cannot keep the submit thread encoding while the GPU idles
+// (a 304-texture burst measured ~75 ms in one batch on BOTW; byte counting alone
+// never splits it, as one reused 32 MB block holds far less than 128 MB of demand).
+// Default OFF (stock byte-count rule only): Gate 1 measured +13 ms submit on
+// the 237-texture burst with the split on (8 batches vs 6 stock).
+// SWX_UPLOAD_SPLIT=1 enables it; SWX_UPLOAD_SPLIT_MAX_TEX=N sets the count
+// (8..4096, default 64) and also enables it.
+static int g_up_batch_tex;   // textures started in this batch (up_alloc is per-texture)
+static int swx_upload_split_max(void) {
+    static int n = -1;
+    if (n < 0) {
+        const char *e = getenv("SWX_UPLOAD_SPLIT");
+        const char *m = getenv("SWX_UPLOAD_SPLIT_MAX_TEX");
+        int v = m ? atoi(m) : 64; if (!(v >= 8 && v <= 4096)) v = 64;
+        n = ((e && atoi(e) != 0) || (m && *m)) ? v : 0;
+    }
+    return n;
+}
 
 
