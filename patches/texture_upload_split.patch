-    if (g_up_staging_bytes && (!g_up_block || need > g_up_block_size - g_up_block_off)
-        && extra > UP_BATCH_BYTES - MIN(g_up_staging_bytes, UP_BATCH_BYTES)) {
+    if (g_up_staging_bytes && ((!g_up_block || need > g_up_block_size - g_up_block_off)
+        && extra > UP_BATCH_BYTES - MIN(g_up_staging_bytes, UP_BATCH_BYTES)
