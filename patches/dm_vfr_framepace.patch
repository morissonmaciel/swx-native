+"""VFR frame-pace stub emulation (BOTW 1.9.0, SWX_VFR=relaxed).
+
+Runs the profile's frame_step() with a recording context, then emulates the
+two vfr stubs' exact emitted words: the setWaitVsyncInterval prologue and
+the VFR ratio compare. Covers: mode off preserves the game's interval/VFR
+flow; vfr mode hands a steady interval 1 and consumes the published
+ratio; the VFR override restores the original flow; an invalid ratio never
+reaches s1. A capstone cross-check pins the emitted mnemonics structurally
+(capstone is a test dependency upstream; skipped when absent).
+"""
+import importlib.util
+import os
+import struct
+import sys
+import unittest
+
+D = os.path.dirname
+REPO = D(D(D(D(os.path.abspath(__file__)))))
+sys.path.insert(0, os.path.join(REPO, 'dm', 'tools'))
+
+try:
+    from capstone import Cs, CS_ARCH_ARM64, CS_MODE_ARM
+    HAS_CAPSTONE = True
+except ImportError:
+    HAS_CAPSTONE = False
+
+CODE_BASE = 0x2000000
+STATE_BASE = 0x2200000
+VFR = 0x300010000
+FW = 0x300020000
+
+
+def load_profile():
+    path = os.path.join(REPO, 'dm', 'games', '01007EF00011E000', 'patches.py')
+    spec = importlib.util.spec_from_file_location('botw_vfr_patches', path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class FakeCtx:
+    def __init__(self):
+        self.code = []
+        self.sites = {}
+        self.puts = []
+        self.state = STATE_BASE
+        self.capabilities = set()
+        self.render_scale = 0
+
+    def here(self):
+        return CODE_BASE + 4 * len(self.code)
+
+    def emit(self, w):
+        self.code.append(w)
+
+    def site(self, off, orig):
+        self.sites[off] = orig
+
+    def put(self, off, words, why):
+        self.puts.append((off, list(words), why, len(self.code)))   # span ends here
+
+
+def b_target(site, word):
+    imm = word & 0x3FFFFFF
+    if imm & 0x2000000:
+        imm -= 1 << 26
+    return site + imm * 4
+
+
+class Cpu:
+    def __init__(self, code):
+        self.code = code
+        self.x = [0] * 31
+        self.sp = 0x400000000
+        self.s = [0] * 32
+        self.mem = {}
+        self.N = self.Z = self.C = self.V = 0
+        self.pc = 0
+
+    def w(self, i):
+        return self.x[i] & 0xFFFFFFFF if i < 31 else 0
+
+    def set_w(self, i, v):
+        if i < 31:
+            self.x[i] = v & 0xFFFFFFFF
+
+    def set_x(self, i, v):
+        if i < 31:
+            self.x[i] = v & 0xFFFFFFFFFFFFFFFF
+
+    def rd8(self, a):
+        return self.mem.get(a, 0)
+
+    def rd32(self, a):
+        return sum(self.mem.get(a + i, 0) << (8 * i) for i in range(4))
+
+    def rd64(self, a):
+        return sum(self.mem.get(a + i, 0) << (8 * i) for i in range(8))
+
+    def wr(self, a, v, n):
+        for i in range(n):
+            self.mem[a + i] = (v >> (8 * i)) & 0xFF
+
+    def subs32(self, a, b):
+        r = (a - b) & 0xFFFFFFFF
+        self.N = (r >> 31) & 1
+        self.Z = 1 if r == 0 else 0
+        self.C = 1 if a >= b else 0
+        self.V = 1 if ((a ^ b) & (a ^ r)) >> 31 else 0
+        return r
+
+    def step(self):
+        w = self.code[(self.pc - CODE_BASE) // 4]
+        nxt = self.pc + 4
+
+        def branch(cond):
+            nonlocal nxt
+            if cond:
+                imm = (w >> 5) & 0x7FFFF
+                if imm & 0x40000:
+                    imm -= 1 << 19
+                nxt = self.pc + imm * 4
+
+        if w & 0x9F000000 == 0x90000000:   # ADRP
+            imm = (((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3) << 12
+            if imm & (1 << 32):
+                imm -= 1 << 33
+            self.set_x(w & 31, (self.pc & ~0xFFF) + imm)
+        elif w & 0xFFC00000 == 0xB9400000:   # LDR Wt
+            self.set_w(w & 31, self.rd32(self.x[(w >> 5) & 31] + ((w >> 10) & 0xFFF) * 4))
+        elif w & 0xFFC00000 == 0xF9400000:   # LDR Xt
+            self.set_x(w & 31, self.rd64(self.x[(w >> 5) & 31] + ((w >> 10) & 0xFFF) * 8))
+        elif w & 0xFFC00000 == 0x39400000:   # LDRB Wt
+            self.set_w(w & 31, self.rd8(self.x[(w >> 5) & 31] + ((w >> 10) & 0xFFF)))
+        elif w & 0xFFC00000 == 0xBD400000:   # LDR St
+            self.s[w & 31] = self.rd32(self.x[(w >> 5) & 31] + ((w >> 10) & 0xFFF) * 4)
+        elif w & 0xFFC00000 == 0xF9000000:   # STR Xt
+            self.wr(self.x[(w >> 5) & 31] + ((w >> 10) & 0xFFF) * 8, self.x[w & 31], 8)
+        elif w & 0xFFC00000 == 0xA9800000:   # STP Xt1, Xt2, [Xn, #imm]!
+            imm = ((w >> 15) & 0x7F)
+            if imm & 0x40:
+                imm -= 1 << 7
+            self.sp += imm * 8
+            self.wr(self.sp, self.x[(w >> 10) & 31], 8)
+            self.wr(self.sp + 8, self.x[w & 31], 8)
+        elif w & 0xFFFFFC00 == 0x1E260000:   # FMOV Wd, Sn
+            self.set_w(w & 31, self.s[(w >> 5) & 31])
+        elif w & 0xFFE0FC00 == 0x1E204000:   # FMOV Sd, Sn
+            self.s[w & 31] = self.s[(w >> 5) & 31]
+        elif w & 0xFF000000 == 0x71000000:   # SUBS Wd, Wn, #imm
+            imm = ((w >> 10) & 0xFFF) << (((w >> 22) & 1) * 12)
+            self.set_w(w & 31, self.subs32(self.w((w >> 5) & 31), imm))
+        elif w & 0xFF800000 == 0x52800000:   # MOVZ Wd, #imm16
+            self.set_w(w & 31, ((w >> 5) & 0xFFFF) << (((w >> 21) & 3) * 16))
+        elif w & 0xFF800000 == 0x72800000:   # MOVK Wd, #imm16, lsl #16*hw
+            sh = ((w >> 21) & 3) * 16
+            self.set_w(w & 31, (self.w(w & 31) & ~(0xFFFF << sh)) | (((w >> 5) & 0xFFFF) << sh))
+        elif w & 0xFF200000 == 0x6B000000:   # SUBS Wd, Wn, Wm (CMP)
+            self.subs32(self.w((w >> 5) & 31), self.w((w >> 16) & 31))
+        elif w & 0xFF000000 in (0x34000000, 0xB4000000):   # CBZ
+            if (w & 0x80000000) == 0:
+                branch(self.w(w & 31) == 0)
+            else:
+                branch(self.x[w & 31] == 0)
+        elif w & 0xFF000000 in (0x35000000, 0xB5000000):   # CBNZ
+            if (w & 0x80000000) == 0:
+                branch(self.w(w & 31) != 0)
+            else:
+                branch(self.x[w & 31] != 0)
+        elif w & 0xFF00001F == 0x54000008:   # B.HI
+            branch(self.C == 1 and self.Z == 0)
+        elif w & 0xFC000000 == 0x14000000:   # B
+            imm = w & 0x3FFFFFF
+            if imm & 0x2000000:
+                imm -= 1 << 26
+            nxt = self.pc + imm * 4
+        elif w & 0xFFFFFC1F == 0x1E202000:   # FCMP Sn, Sm
+            a = self.s[(w >> 5) & 31]
+            b = self.s[(w >> 16) & 31]
+            fa, fb = struct.unpack('<f', struct.pack('<I', a))[0], struct.unpack('<f', struct.pack('<I', b))[0]
+            if fa != fa or fb != fb:
+                self.N, self.Z, self.C, self.V = 0, 0, 1, 1
+            else:
+                self.N = 1 if fa < fb else 0
+                self.Z = 1 if fa == fb else 0
+                self.C = 1 if fa >= fb else 0
+                self.V = 0
+        elif w & 0xFF000000 == 0x2A000000:   # MOV Wd, Wm
+            self.set_w(w & 31, self.w((w >> 16) & 31))
+        elif w & 0xFFE0FC00 == 0x8B204000:   # ADD Xd, Xn, Wm, UXTW
+            self.set_x(w & 31, self.x[(w >> 5) & 31] + self.w((w >> 16) & 31))
+        else:
+            raise AssertionError('emulator: unhandled word %08x at %#x' % (w, self.pc))
+        self.pc = nxt
+
+    def run(self, start, limit=200):
+        self.pc = start
+        end = CODE_BASE + 4 * len(self.code)
+        for _ in range(limit):
+            if not CODE_BASE <= self.pc < end:
+                return
+            self.step()
+        raise AssertionError('emulator: did not leave the stub')
+
+
+def f32(x):
+    return struct.unpack('<f', struct.pack('<f', x))[0]
+
+
+def bits(x):
+    return struct.unpack('<I', struct.pack('<f', x))[0]
+
+
+class VfrStub(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        mod = load_profile()
+        ctx = FakeCtx()
+        mod.frame_step(ctx)
+        cls.ctx = ctx
+        cls.code = ctx.code
+        # tell the ADRP+LDRX pairs where the VFR lives
+        cls._vfr_slot_hits = []
+        for i, w in enumerate(ctx.code):
+            if w & 0x9F000000 == 0x90000000 and (w & 31) == 17:
+                pc = CODE_BASE + 4 * i
+                imm = ((((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3) << 12)
+                if imm & (1 << 32):
+                    imm -= 1 << 33
+                cls._vfr_slot_hits.append((pc & ~0xFFF) + imm)
+
+    def machine(self, mode=0, override=0, vfr=True, target=60, step=2, ratio=f32(1.0)):
+        cpu = Cpu(self.code)
+        cpu.wr(STATE_BASE + 0x00, target, 4)
+        cpu.wr(STATE_BASE + 0x20, step, 4)
+        cpu.wr(STATE_BASE + 0x30, 100, 8)
+        cpu.wr(STATE_BASE + 0xA8, mode, 4)
+        cpu.wr(STATE_BASE + 0xA0, bits(ratio), 4)
+        v = VFR if vfr else 0
+        for base in self._vfr_slot_hits:
+            cpu.wr(base + 0x890, v, 8)
+        if vfr:
+            cpu.wr(VFR + 0x29, override, 1)
+            cpu.wr(VFR + 0x2C, 2, 4)
+        cpu.x[0] = FW
+        cpu.x[19] = VFR if vfr else 0   # the original entry code holds the VFR in x19 by the time it reaches the ratio site
+        cpu.set_w(1, 3)   # the game's interval on entry
+        return cpu
+
+    def setter_start(self):
+        for off, words, why, _ in self.ctx.puts:
+            if off == 0x11269b8 and len(words) == 1:
+                return b_target(off, words[0])
+        raise AssertionError('setter stub not emitted')
+
+    def test_capability_declared(self):
+        self.assertIn('VFR_FRAMEPACE', self.ctx.capabilities)
+        self.assertIn(0x151d484, self.ctx.sites)
+        self.assertEqual(self.ctx.sites[0x151d484], '2020201e')
+
+    def test_setter_off_preserves_game_interval(self):
+        start = self.setter_start()
+        cpu = self.machine(mode=0)
+        cpu.run(start)
+        self.assertEqual(cpu.w(1), 2)   # the host's step, not the game's 3
+        self.assertEqual(cpu.rd64(STATE_BASE + 0x30), 102)
+
+    def test_setter_vfr_forces_interval_1(self):
+        start = self.setter_start()
+        cpu = self.machine(mode=1)
+        cpu.run(start)
+        self.assertEqual(cpu.w(1), 1)
+        self.assertEqual(cpu.rd64(STATE_BASE + 0x30), 101)
+
+    def test_setter_override_restores_original(self):
+        start = self.setter_start()
+        cpu = self.machine(mode=1, override=1)
+        cpu.run(start)
+        self.assertEqual(cpu.w(1), 3)   # the game's interval, untouched
+        self.assertEqual(cpu.rd64(STATE_BASE + 0x30), 100)
+
+    def test_setter_no_vfr_restores_original(self):
+        start = self.setter_start()
+        cpu = self.machine(mode=1, vfr=False)
+        cpu.run(start)
+        self.assertEqual(cpu.w(1), 3)
+
+    def ratio_start(self):
+        for off, words, why, _ in self.ctx.puts:
+            if off == 0x151d484 and len(words) == 1:
+                return b_target(off, words[0])
+        raise AssertionError('vfr ratio stub not emitted')
+
+    def test_ratio_off_runs_original_compare(self):
+        cpu = self.machine(mode=0)
+        cpu.s[0] = bits(f32(0.5))
+        cpu.s[1] = bits(f32(1.0))
+        cpu.run(self.ratio_start())
+        self.assertEqual(cpu.s[1], bits(f32(1.0)))   # candidate untouched
+
+    def test_ratio_vfr_consumes_published(self):
+        cpu = self.machine(mode=1, ratio=f32(0.5))
+        cpu.s[0] = bits(f32(1.0))
+        cpu.s[1] = bits(f32(2.0))
+        cpu.run(self.ratio_start())
+        self.assertEqual(cpu.s[1], bits(f32(0.5)))
+
+    def test_ratio_override_restores_original(self):
+        cpu = self.machine(mode=1, override=1, ratio=f32(0.5))
+        cpu.s[0] = bits(f32(1.0))
+        cpu.s[1] = bits(f32(2.0))
+        cpu.run(self.ratio_start())
+        self.assertEqual(cpu.s[1], bits(f32(2.0)))
+
+    def test_ratio_invalid_never_consumed(self):
+        for bad in (0x00000000, 0x80000000, 0x7FC00000, 0x40000001, 0x40200000, 0x7F800000):
+            cpu = self.machine(mode=1, ratio=f32(0.5))
+            cpu.s[0] = bits(f32(1.0))
+            cpu.s[1] = bits(f32(2.0))
+            cpu.wr(STATE_BASE + 0xA0, bad, 4)
+            cpu.run(self.ratio_start())
+            self.assertEqual(cpu.s[1], bits(f32(2.0)), 'bits %#x must not reach s1' % bad)
+
+    def test_ratio_boundary_consumed(self):
+        for good, want in ((0x00000001, 1), (0x3F800000, 1), (0x40000000, 1)):
+            cpu = self.machine(mode=1, ratio=f32(0.5))
+            cpu.s[0] = bits(f32(1.0))
+            cpu.s[1] = bits(f32(2.0))
+            cpu.wr(STATE_BASE + 0xA0, good, 4)
+            cpu.run(self.ratio_start())
+            self.assertEqual(cpu.s[1], good, 'bits %#x must reach s1' % good)
+
+    @unittest.skipUnless(HAS_CAPSTONE, 'capstone is not installed')
+    def test_emitted_mnemonics(self):
+        md = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+        md.detail = False
+        start = self.setter_start()
+        idx = (start - CODE_BASE) // 4
+        got = [ins.mnemonic for ins in md.disasm(bytes(bytearray(struct.pack('<%dI' % 19, *self.code[idx:idx + 19]))), start)]
+        self.assertEqual(got, ['adrp', 'ldr', 'cbz', 'adrp', 'ldr', 'cbz', 'ldrb', 'cbnz', 'ldr', 'cbnz',
+                               'ldr', 'cbz', 'mov', 'b', 'mov', 'ldr', 'add', 'str', 'stp'])
+        start = self.ratio_start()
+        idx = (start - CODE_BASE) // 4
+        got = [ins.mnemonic for ins in md.disasm(bytes(bytearray(struct.pack('<%dI' % 16, *self.code[idx:idx + 16]))), start)]
+        self.assertEqual(got, ['adrp', 'ldr', 'cbz', 'ldrb', 'cbnz', 'ldr', 'fmov', 'subs', 'mov', 'movk',
+                               'subs', 'b.hi', 'fmov', 'b', 'fcmp', 'b'])
+
+
+if __name__ == '__main__':
+    unittest.main()
