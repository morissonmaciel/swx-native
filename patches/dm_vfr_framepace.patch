+// VFR pace unit tests: given slot sequences, the applied steps, debt and
+// publish words are hand-calculated. Periods: P60 = 16666667 ns, P90, P120.
+#include "../nvn/nvn_vfr_pace.h"
+#include <stdio.h>
+
+static int fail = 0, n = 0;
+#define CHECK(got, want, why) do { n++; int ok = (got) == (want); printf("%-58s %s\n", why, ok ? "✓" : "✗"); fail += !ok; if (!ok) printf("   got %lld want %lld\n", (long long)(got), (long long)(want)); } while (0)
+#define CHECKF(got, want, why) do { n++; double d_ = (got) - (want); int ok = d_ < 1e-9 && d_ > -1e-9; printf("%-58s %s\n", why, ok ? "✓" : "✗"); fail += !ok; if (!ok) printf("   got %.9f want %.9f\n", (double)(got), (double)(want)); } while (0)
+#define CHECKT(cond, why) do { n++; int ok = !!(cond); printf("%-58s %s\n", why, ok ? "✓" : "✗"); fail += !ok; } while (0)
+
+int main(void) {
+    const uint64_t MS = 1000000;
+    const uint64_t P60 = 16666667, P120 = 8333333;
+    uint64_t bits = 0;
+
+    // Steady 60 fps: the average is the period, no debt, ratio 1.0
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 1000 * MS; double s = swx_vfr_step(&p, t, &bits);
+        CHECKF(s, 0.0, "first slot: no publish yet");
+        for (int i = 1; i <= 6; i++) { t += P60; s = swx_vfr_step(&p, t, &bits); }
+        CHECKF(s, P60 / 1e9, "steady 60 fps: applied = one period");
+        CHECKF(p.debt_s, 0.0, "steady 60 fps: no debt");
+        float ratio, secs; uint32_t lo = bits & 0xffffffffu, hi = bits >> 32;
+        memcpy(&ratio, &lo, 4); memcpy(&secs, &hi, 4);
+        CHECKF(ratio, (float)(P60 / 1e9 * 30.0), "publish: ratio = seconds x 30");
+        CHECKF(secs, (float)(P60 / 1e9), "publish: seconds = applied step");
+        CHECK(p.steps, 6, "six steps published");
+    }
+    // Steady 120 fps: ratio 0.5
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 2000 * MS, bits = 0; double s = 0;
+        for (int i = 0; i <= 6; i++) { s = swx_vfr_step(&p, t, &bits); t += P120; }
+        CHECKF(s, P120 / 1e9, "steady 120 fps: applied = one period");
+        float ratio; uint32_t lo = bits & 0xffffffffu; memcpy(&ratio, &lo, 4);
+        CHECKF(ratio, (float)(P120 / 1e9 * 30.0), "publish: ratio 0.5 at 120 fps");
+    }
+    // Discontinuities: < 1 ms and > 250 ms reset the average, owe nothing
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 3000 * MS, bits = 0;
+        swx_vfr_step(&p, t, &bits); t += P60; swx_vfr_step(&p, t, &bits);
+        double s = swx_vfr_step(&p, t + 500, &bits);   // 0.5 us later: torn slot
+        CHECKF(s, 0.0, "< 1 ms: rejected, no publish");
+        CHECK(p.count, 0, "< 1 ms: average restarted");
+        s = swx_vfr_step(&p, t + 300 * MS, &bits);     // 300 ms later: a load
+        CHECKF(s, 0.0, "> 250 ms: rejected, no publish");
+        CHECKF(p.debt_s, 0.0, "> 250 ms: nothing owed for a load");
+    }
+    // A hitch inside the window is spread over the next frames, capped at 1/15 s
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 4000 * MS, bits = 0; double s = 0;
+        s = swx_vfr_step(&p, t, &bits);
+        for (int i = 0; i < 5; i++) { t += P60; s = swx_vfr_step(&p, t, &bits); }
+        t += 100 * MS; s = swx_vfr_step(&p, t, &bits);   // hitches: three slow samples in a row
+        t += 100 * MS; s = swx_vfr_step(&p, t, &bits);
+        t += 100 * MS; s = swx_vfr_step(&p, t, &bits);
+        CHECKT(s <= 1.0 / 15.0 + 1e-9, "hitch: applied step never over 1/15 s");
+        CHECKT(p.debt_s > 0.0, "hitch: the capped-away time is owed");
+        double debt0 = p.debt_s;
+        for (int i = 0; i < 40; i++) { t += P60; s = swx_vfr_step(&p, t, &bits); }   // game time converges
+        CHECKT(p.debt_s < debt0, "headroom: the debt drains, never bursts");
+        CHECKT(s <= 1.0 / 15.0 + 1e-9, "payback: still never over 1/15 s");
+    }
+    // Sustained overload: capped steps, debt bounded, game slows instead of jumping
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 5000 * MS, bits = 0; double s = 0, worst = 0;
+        s = swx_vfr_step(&p, t, &bits);
+        for (int i = 0; i < 60; i++) { t += 100 * MS; s = swx_vfr_step(&p, t, &bits); if (s > worst) worst = s; }
+        CHECKT(worst <= 1.0 / 15.0 + 1e-9, "overload: no step over 1/15 s, ever");
+        CHECKT(p.debt_s <= 0.25 + 1e-9, "overload: debt bounded at 0.25 s");
+    }
+    // End to end at header level: nvn_pace beats 60 and 120 Hz, game time tracks wall clock
+    for (int hi = 0; hi < 2; hi++) {
+        uint64_t P = hi ? P120 : P60;
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 9000 * MS, slot = 0; double game = 0; uint64_t bits = 0;
+        for (int k = 0; k < 600; k++) {   // acquire waits its slot, 1 ms of work, present hands it back
+            uint64_t w = nvn_pace(&p.pace, t, P); t += w; slot = t; t += MS;
+            double s = swx_vfr_step(&p, slot, &bits); game += s > 0 ? s : P / 1e9;
+        }
+        double wall = (t - 9000 * MS) / 1e9, err = game / wall;
+        n++; int ok = err > 0.99 && err < 1.01;
+        printf("%-58s %s (%.4f)\n", hi ? "120 Hz: game time tracks wall clock" : "60 Hz: game time tracks wall clock", ok ? "✓" : "✗", err);
+        fail += !ok;
+    }
+    // Suspend forgets everything: the next slot restarts, nothing is paid back
+    {
+        swx_vfr_pace p; memset(&p, 0, sizeof p);
+        uint64_t t = 6000 * MS, bits = 0;
+        swx_vfr_step(&p, t, &bits); t += P60; swx_vfr_step(&p, t, &bits);
+        swx_vfr_reset(&p);
+        CHECK(p.prev_slot, 0, "reset: no previous slot");
+        CHECKF(swx_vfr_step(&p, t + 500 * MS, &bits), 0.0, "reset: a late return starts over, no payback");
+    }
+    printf("%d checks, %d failures\n", n, fail);
+    return fail != 0;
+}
