+// VFR frame pace (SWX_VFR=relaxed, experimental opt-in): the game's
+// clock follows a steady host beat instead of the Switch's 1/2/3-vsync
+// intervals. Pure logic, shared by Mac / iOS; unit test tests/t_vfr_pace.c.
+// The caller (hle_nvn.c) owns the environment, the display rate, the window
+// slot from nvn_pace and the state page; this header owns the per-frame time:
+// a 5-sample moving average of the delivered acquire slots (MNG's shape),
+// discontinuity rejection, a 1/15 s step cap, and a bounded debt so the
+// accumulated game time converges back to wall clock without ever handing
+// the simulation a destructive step (SW's guard).
+//
+// State page words (guest stubs + host share this layout; above the BOTW
+// duo_anchor params at +0x80..+0x98, and below its FOV history at +0xfc):
+// +0xA0 u64 atomic pair low float ratio (game seconds x 30) high float seconds
+// +0xA8 u32 vfr_mode (1 = the stubs route through the host's ratio)
+// +0xAC u32 flags, reserved, 0
+// +0xB0 u32 real-time steps published
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+#include "nvn_pace.h"
+
+#define SWX_VFR_RATIO_OFF 0xA0
+#define SWX_VFR_MODE_OFF 0xA8
+#define SWX_VFR_FLAGS_OFF 0xAC
+#define SWX_VFR_STEPS_OFF 0xB0
+#define SWX_VFR_NSAMPLES 5
+#define SWX_VFR_STEP_MAX_S (1.0 / 15.0)   // a step is never more than 1/15 s
+#define SWX_VFR_DEBT_MAX_S 0.25            // owed past a stall is dropped, not replayed (nothing owed for a load)
+#define SWX_VFR_DT_MIN_S 0.001             // below: not a frame (duplicate/torn slot)
+#define SWX_VFR_DT_MAX_S 0.25              // above: a discontinuity (load, hitch), not owed
+
+typedef struct {
+    nvn_pacer pace;                 // the steady beat (nvn_pace semantics: early waits, sub-period keeps phase, a full period behind restarts)
+    uint64_t prev_slot;             // last acquire slot handed to the game (0 = none yet)
+    double samples[SWX_VFR_NSAMPLES];
+    unsigned count, next;           // valid samples, next write index
+    double debt_s;                  // game time owed but not yet delivered (>= 0)
+    uint64_t steps;                 // real-time steps published
+    uint64_t n;                     // measured frames this window (caller resets per report)
+    double raw_sum_s, applied_sum_s;
+} swx_vfr_pace;
+
+// Ratio+seconds publish word (MNG's shape): low float ratio = seconds x 30,
+// high float seconds, one 64-bit atomic store.
+static inline uint64_t swx_vfr_bits(float seconds) {
+    float ratio = seconds * 30.0f;
+    uint32_t lo, hi;
+    memcpy(&lo, &ratio, 4); memcpy(&hi, &seconds, 4);
+    return (uint64_t)lo | ((uint64_t)hi << 32);
+}
+
+// Feed one delivered acquire slot (monotonic ns). Returns the applied step in
+// seconds and writes the publish word, or 0 with no write on the first slot
+// and on discontinuities (the game keeps its last ratio then).
+static inline double swx_vfr_step(swx_vfr_pace *p, uint64_t slot_ns, uint64_t *bits) {
+    if (!p->prev_slot) { p->prev_slot = slot_ns; return 0.0; }
+    double dt = (double)(slot_ns - p->prev_slot) * 1e-9;
+    p->prev_slot = slot_ns;
+    if (dt < SWX_VFR_DT_MIN_S || dt > SWX_VFR_DT_MAX_S) {
+        p->count = p->next = 0; p->debt_s = 0.0;   // a load or a torn slot: start the average over, owe nothing
+        return 0.0;
+    }
+    p->samples[p->next++ % SWX_VFR_NSAMPLES] = dt;
+    if (p->count < SWX_VFR_NSAMPLES) p->count++;
+    double sum = 0.0;
+    for (unsigned i = 0; i < p->count; i++) sum += p->samples[i];
+    double avg = sum / p->count;
+    double applied = avg;
+    if (avg > SWX_VFR_STEP_MAX_S) {   // too slow to catch up: deliver the cap, owe the rest (bounded)
+        p->debt_s += avg - SWX_VFR_STEP_MAX_S;
+        applied = SWX_VFR_STEP_MAX_S;
+        if (p->debt_s > SWX_VFR_DEBT_MAX_S) p->debt_s = SWX_VFR_DEBT_MAX_S;
+    } else if (p->debt_s > 0.0) {         // headroom: pay back half of it, still capped
+        double repay = p->debt_s < (SWX_VFR_STEP_MAX_S - avg) * 0.5 ? p->debt_s : (SWX_VFR_STEP_MAX_S - avg) * 0.5;
+        applied += repay; p->debt_s -= repay;
+    }
+    p->n++; p->raw_sum_s += dt; p->applied_sum_s += applied;
+    p->steps++;
+    *bits = swx_vfr_bits((float)applied);
+    return applied;
+}
+
+// Suspend: forget the beat, the average and the debt, so the next acquire
+// restarts the phase instead of paying back a stall in one jump.
+static inline void swx_vfr_reset(swx_vfr_pace *p) {
+    p->pace.target = 0; p->prev_slot = 0;
+    p->count = p->next = 0; p->debt_s = 0.0;
+    p->n = 0; p->raw_sum_s = p->applied_sum_s = 0.0;
+}
