+static void normalize_shadow_res(void) {
+    // Sun shadow resolution (SWX_SHADOW_RESOLUTION): 896 (Console) or 2048 (High). An explicit invalid
+    // value normalizes to 896 after the env files, keeping the key's fixed-key list entry (env_file()
+    // already recorded an env.txt origin; a launch-environment value belongs in the launch list).
+    const char *sr = getenv("SWX_SHADOW_RESOLUTION");
+    char bad[64];
+    if (!sr || !*sr || !strcmp(sr, "896") || !strcmp(sr, "2048")) return;
+    snprintf(bad, sizeof bad, "%s", sr);
+    setenv("SWX_SHADOW_RESOLUTION", "896", 1);
+    fprintf(stderr, "launcher: env SWX_SHADOW_RESOLUTION=896 (invalid SWX_SHADOW_RESOLUTION=%s from %s, using Console)\n",
+            bad, has_key(g_file_keys, "SWX_SHADOW_RESOLUTION") ? "env.txt" : "environment");
+    if (!has_key(g_file_keys, "SWX_SHADOW_RESOLUTION") && !has_key(g_launch_keys, "SWX_SHADOW_RESOLUTION")) add_key(&g_launch_keys, "SWX_SHADOW_RESOLUTION");
+}
+
