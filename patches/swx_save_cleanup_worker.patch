 static pthread_t g_swx_del_thr; static int g_swx_del_busy; static pthread_mutex_t g_swx_del_mu = PTHREAD_MUTEX_INITIALIZER;
 static void *swx_save_bg_rm(void *arg) { char *path = arg; if (rm_tree(path)) { static int n; if (n++ < 4) LOG("DM_SAVE_ASYNC: background delete of %s failed errno=%d (next commit pre-clears it)", path, errno); } free(path); return NULL; }
+// swx_save_cleanup_worker: the swapped-out old version leaves the frame on a
+// persistent QOS_CLASS_BACKGROUND worker instead of a thread per commit. The
+// FIFO holds 4 staged paths plus the one being deleted; the worker only takes
+// its own mutex (never g_lock/PATH_LOCK or a game lock) and drops it before
+// rm_tree. A full queue or a worker that will not start falls back to a
+// synchronous delete outside the mount locks; the commit stays published.
+#define SWX_SAVE_QN 4
+static char *swx_save_q[SWX_SAVE_QN];
+static int swx_save_qh, swx_save_qn;
+static pthread_mutex_t swx_save_qmu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t swx_save_qcv = PTHREAD_COND_INITIALIZER;
+static pthread_t swx_save_qthr; static int swx_save_qon;
+static void *swx_save_worker_fn(void *arg) {
+    (void)arg;
+    pthread_set_qos_class_self_np(QOS_CLASS_BACKGROUND, 0);
+    for (;;) {
+        pthread_mutex_lock(&swx_save_qmu);
+        while (!swx_save_qn) pthread_cond_wait(&swx_save_qcv, &swx_save_qmu);
+        char *path = swx_save_q[swx_save_qh]; swx_save_qh = (swx_save_qh + 1) % SWX_SAVE_QN; swx_save_qn--;
+        pthread_mutex_unlock(&swx_save_qmu);
+        if (rm_tree(path)) { static int n; if (n++ < 4) LOG("SWX_SAVE_ASYNC: background delete of %s failed errno=%d (a later mount pre-clears it)", path, errno); }
+        free(path);
+    }
+    return NULL;
+}
+// Takes ownership of path on 1; on 0 (queue full or no worker) the caller deletes it outside the locks.
+static int swx_save_enqueue(char *path) {
+    int ok = 0;
+    pthread_mutex_lock(&swx_save_qmu);
+    if (!swx_save_qon && !pthread_create(&swx_save_qthr, NULL, swx_save_worker_fn, NULL)) { pthread_detach(swx_save_qthr); swx_save_qon = 1; }
+    if (swx_save_qon && swx_save_qn < SWX_SAVE_QN) {
+        swx_save_q[(swx_save_qh + swx_save_qn) % SWX_SAVE_QN] = path; swx_save_qn++; ok = 1;
+        pthread_cond_signal(&swx_save_qcv);
+    }
+    pthread_mutex_unlock(&swx_save_qmu);
+    return ok;
+}
+// Outside the mount locks: hand the staged old version to the worker, or delete it here when the queue is full or the worker would not start. The commit is already published either way.
+static void swx_save_finish(char *staged) {
+    if (!staged) return;
+    if (swx_save_enqueue(staged)) return;
+    { static int n; if (n++ < 4) LOG("SWX_SAVE_ASYNC: cleanup queue full or worker unavailable: deleting %s synchronously (commit already published)", staged); }
+    rm_tree(staged); free(staged);
+}
+// Crash orphans of the mkdtemp staging (<commit>.swx-save-<pid>.XXXXXX): only a staging whose PID is provably gone (kill(pid,0) == ESRCH) is removed; a live
+// or uncertain PID (kill succeeds or EPERM) belongs to a running committer and stays. A removal failure only warns; the mount goes on with the published save.
+static void swx_save_sweep_orphans(const char *commit) {
+    const char *slash = strrchr(commit, '/'), *base = slash ? slash + 1 : commit;
+    size_t dl = slash ? (size_t)(slash - commit) : 0, bl = strlen(base);
+    char parent[1100];
+    if (!dl) strlcpy(parent, ".", sizeof parent);
+    else { if (dl >= sizeof parent) return; memcpy(parent, commit, dl); parent[dl] = 0; }
+    DIR *d = opendir(parent); if (!d) return;
+    struct dirent *e;
+    while ((e = readdir(d))) {
+        const char *n = e->d_name, *p, *dot;
+        size_t nl = strlen(n);
+        long pid = 0;
+        if (nl <= bl + 17 || strncmp(n, base, bl) || strncmp(n + bl, ".swx-save-", 10)) continue;
+        p = n + bl + 10; dot = strchr(p, '.');
+        if (!dot || dot == p) continue;
+        for (const char *q = p; q < dot; q++) { if (*q < '0' || *q > '9') { pid = -1; break; } pid = pid * 10 + (*q - '0'); }
+        if (pid <= 0 || (pid_t)pid != pid) continue;
+        if (strlen(dot + 1) != 6) continue;
+        { int k, ok = 1; for (k = 0; k < 6; k++) { char c = dot[1 + k]; if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) { ok = 0; break; } } if (!ok) continue; }
+        if (!kill((pid_t)pid, 0) || errno != ESRCH) continue;   // alive or uncertain: still active
+        { char full[1200]; snprintf(full, sizeof full, "%s/%s", parent, n);
+          if (rm_tree(full) && errno != ENOENT) LOG("save mount: orphan staging %s (PID %ld gone) could not be removed errno=%d; the published save is used", full, pid, errno);
+          else LOG("save mount: removed orphan staging %s (PID %ld gone)", full, pid); }
+    }
+    closedir(d);
+}
+// Today's .new path, kept for a failed mkdtemp and for =0 (then fully synchronous: the async branches below read the same flag). Caller holds the path and mount locks.
+static Result commit_legacy_new_locked(int i) {
+    char neu[1100]; snprintf(neu, sizeof neu, "%s.new", g_mnt[i].commit);
+    Result r = RES_OK;
+    if (swx_save_async_on()) {   // never reuse the staging path while its background delete runs (normally already done)
+        pthread_mutex_lock(&g_swx_del_mu);
+        if (g_swx_del_busy) { pthread_join(g_swx_del_thr, NULL); g_swx_del_busy = 0; }
+        pthread_mutex_unlock(&g_swx_del_mu);
+    }
+    if (!access(neu, F_OK) && rm_tree(neu)) { LOG("[RED] save commit: cannot clear the %s left over errno=%d (committed version unchanged)", neu, errno); r = RES_FAIL; }
+    else if (clonefile(g_mnt[i].dir, neu, 0)) { LOG("[RED] save commit: clonefile %s failed errno=%d (committed version unchanged)", neu, errno); r = RES_FAIL; }
+    else if (renamex_np(neu, g_mnt[i].commit, RENAME_SWAP)) { LOG("[RED] save commit: atomic swap failed errno=%d (committed version unchanged)", errno); rm_tree(neu); r = RES_FAIL; }
+    else if (swx_save_async_on()) {                                 // the old version that was swapped out: delete it off-thread
+        char *stale = strdup(neu);                                  // joinable thread: the next commit's pre-clear joins it, so the
+        int bg = 0;                                                 // staging path is never reused mid-delete (normally already done)
+        pthread_mutex_lock(&g_swx_del_mu);
+        if (stale && !pthread_create(&g_swx_del_thr, NULL, swx_save_bg_rm, stale)) { g_swx_del_busy = 1; bg = 1; }
+        pthread_mutex_unlock(&g_swx_del_mu);
+        if (!bg) { free(stale); rm_tree(neu); }                    // thread spawn failed: today's synchronous delete
+    }
+    else rm_tree(neu);                                                  // the old version that was swapped out
+    return r;
+}
