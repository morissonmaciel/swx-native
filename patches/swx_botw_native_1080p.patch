+// Native 1080p bypass (SWX_RES_BYPASS=1080p, BOTW 1.9.0): scene, canvas and VFR snapshots at 1920x1080.
+// The loader keeps the request host-side after validating the env value, the SWX_NATIVE_1080P capability and docked
+// mode; the frontend forces the internal resolution (+0x10 = 1.0f / +0x14 = 1, state +0xB4 = 1) at boot before the guest
+// thread starts, in window and fullscreen alike. Window mode fixes the content at 1920x1080 pixels and re-verifies across
+// monitors; fullscreen lets the drawable follow the view and the stock present path scales it (MetalFX or bilinear per
+// DM_PRESENT_UPSCALE, picked by the presenter from the drawable). A lost 1:1 falls back to the normal present with the
+// scene and canvas staying 1080p. Main thread only
+static NSWindow *g_bp_win; static int g_bp_on; static int g_bp_fixed; static int g_bp_trans; static NSUInteger g_bp_screen; static NSRect g_bp_frame;
+static int bp_requested(void) {
+    const char *e = getenv("SWX_RES_BYPASS");
+    return e && !strcmp(e, "1080p") && swx_res_bypass_requested();
+}
+static void bp_reject(NSWindow *win, NSSize was, const char *why) {
+    if (dm_fps_state) *(uint32_t *)(dm_fps_state + 0xB4) = 0;
+    if (win && was.width > 0 && was.height > 0) [win setContentSize:was];
+    LOG("front end: 1080p bypass off (%s); stock path", why);
+}
+// Force the internal 1080p resolution before the guest thread starts (window and fullscreen alike)
+static void bp_force_internal(void) {
+    float one = 1.0f; uint32_t on = 1;
+    memcpy(dm_fps_state + 0x10, &one, sizeof one); memcpy(dm_fps_state + 0x14, &on, sizeof on);
+    memcpy(dm_fps_state + 0xB4, &on, sizeof on);   // confirmed active: only now may the scene stub use the 1920 base
+    g_bp_on = 1;
+}
+// Size the content for exactly 1920x1080 pixels on the current screen; 1 = fixed 1:1, 0 = fallback (internal stays 1080p)
+static int bp_enforce_windowed(void) {
+    if (!g_bp_win) return 0;
+    NSScreen *screen = g_bp_win.screen ?: NSScreen.mainScreen;
+    if (!screen) return 0;
+    CGFloat s = screen.backingScaleFactor; if (s < 1) s = 1;
+    [g_bp_win setContentSize:NSMakeSize(1920.0 / s, 1080.0 / s)];
+    [(DmGameView *)g_bp_win.contentView fitDrawable];
+    if (CGSizeEqualToSize(g_layer.drawableSize, CGSizeMake(1920, 1080)) && NSContainsRect(screen.visibleFrame, g_bp_win.frame)) {
+        g_bp_screen = [screen.deviceDescription[@"NSScreenNumber"] unsignedIntValue]; g_bp_frame = g_bp_win.frame;
+        g_bp_win.styleMask &= ~NSWindowStyleMaskResizable;   // fixed-window policy holds whenever the 1:1 is confirmed
+        return g_bp_fixed = 1;
+    }
+    g_bp_fixed = 0;
+    return 0;
+}
+// Validate the request and activate the internal resolution; window mode additionally fixes the drawable now,
+// a fullscreen boot defers the drawable to the AppKit transition (the present scales it per DM_PRESENT_UPSCALE)
+static int bp_enable(NSWindow *win) {
+    if (!bp_requested()) return 0;
+    if (!dm_opmode()) { bp_reject(win, NSZeroSize, "handheld mode"); return 0; }
+    const char *sa = getenv("DM_SCREEN_ASPECT");
+    if (sa && *sa && strcmp(sa, "0") && strcmp(sa, "auto")) { bp_reject(win, NSZeroSize, "screen aspect incompatible"); return 0; }
+    NSScreen *screen = win.screen ?: NSScreen.mainScreen;
+    if (!screen) { bp_reject(win, NSZeroSize, "no screen"); return 0; }
+    g_bp_win = win;
+    const char *fs = getenv("DM_FULLSCREEN");
+    if (fs && strcmp(fs, "0")) {
+        bp_force_internal();   // fullscreen boot: internal now, the drawable follows the AppKit transition
+        LOG("front end: 1080p bypass active: internal 1920x1080, fullscreen boot (drawable follows the view; SWX_RES_BYPASS=1080p)");
+        return 1;
+    }
+    NSSize was = win.contentView.bounds.size;
+    if (!bp_enforce_windowed()) {   // windowed boot: validate first, only a fitting drawable activates the preset
+        if (was.width > 0 && was.height > 0) { [win setContentSize:was]; [(DmGameView *)win.contentView fitDrawable]; }
+        bp_reject(win, NSZeroSize, "window does not fit 1920x1080");
+        return 0;
+    }
+    CGFloat s = screen.backingScaleFactor; if (s < 1) s = 1;
+    NSSize pts = NSMakeSize(1920.0 / s, 1080.0 / s);
+    bp_force_internal();
+    LOG("front end: 1080p bypass active: content %.0fx%.0f pt on scale %.0f, drawable 1920x1080 (SWX_RES_BYPASS=1080p)", pts.width, pts.height, s);
+    return 1;
+}
+// A screen or fullscreen transition with the preset internal active: in fullscreen the drawable follows the view
+// (the presenter picks MetalFX or bilinear from it per DM_PRESENT_UPSCALE); in window mode the 1920x1080 pixels are
+// re-fixed. Never resizes the window out of a fullscreen transition, never clears the internal 1080p once active
+static void bp_screen_changed(void) {
+    if (!g_bp_on || !g_bp_win) return;
+    if (g_bp_trans) { [(DmGameView *)g_bp_win.contentView fitDrawable]; return; }   // transition in flight: drawable follows, policy suspended
+    if (g_fullscreen || (g_bp_win.styleMask & NSWindowStyleMaskFullScreen)) {
+        [(DmGameView *)g_bp_win.contentView fitDrawable];
