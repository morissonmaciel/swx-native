+        [(DmGameView *)g_bp_win.contentView fitDrawable];
+        if (CGSizeEqualToSize(g_layer.drawableSize, CGSizeMake(1920, 1080))) {
+            LOG("front end: 1080p bypass back on its screen (drawable 1920x1080)");
+            g_bp_fixed = 1;
+            return;
+        }
+    }
+    LOG("front end: 1080p bypass lost its 1:1 output (scene and canvas stay 1080p); normal present until restart");
+}
