# SWX_AA group (launcher.c.patch): a saved "0" reads as the "off" option.
# Canonical names are off|fxaa|smaa; "0" is the value Off saved before the
# SWX_AA row was renamed, so saved_accepted accepts it only where the build
# offers "off", and saved_choices exports "off" in its place (absent/fxaa
# keep the game's FXAA). Mirrors LauncherModel.normalizedSaved. Goes after
# the SWX_NATIVE_RES render-scale block in saved_accepted: an independent
# env-gated block, same rule_env pattern (already declared above).
# verify: dm/mac/launcher.c:SWX_AA off was once
# verify: dm/mac/launcher.c:strcmp(env, "SWX_AA")
diff --git a/dm/mac/launcher.c b/dm/mac/launcher.c
--- a/dm/mac/launcher.c
+++ b/dm/mac/launcher.c
@@ -95,10 +95,20 @@ static int saved_accepted(CFDictionaryRef rule, CFStringRef v, const char *s) {
     if (values && CFGetTypeID(values) == CFArrayGetTypeID()) {
         for (CFIndex i = 0; i < CFArrayGetCount(values); i++) {
             CFTypeRef o = CFArrayGetValueAtIndex(values, i);
             if (CFGetTypeID(o) == CFStringGetTypeID() && CFStringCompare(o, v, 0) == kCFCompareEqualTo) return 1;
         }
+        {   // SWX_AA off was once "0": a saved "0" counts as its "off" option (as LauncherModel.normalizedSaved)
+            char env[128];
+            if (rule_env(rule, env, sizeof env) && !strcmp(env, "SWX_AA") && !strcmp(s, "0")) {
+                for (CFIndex i = 0; i < CFArrayGetCount(values); i++) {
+                    CFTypeRef o = CFArrayGetValueAtIndex(values, i);
+                    if (CFGetTypeID(o) == CFStringGetTypeID() && CFStringCompare(o, CFSTR("off"), 0) == kCFCompareEqualTo) return 1;
+                }
+                return 0;
+            }
+        }
         // A saved render-scale percent from the slider era (1.00 for 1.0): numeric equality, DM_RENDER_SCALE only (no other row compares saved numbers to its options)
         char env[128];
         if (rule_env(rule, env, sizeof env) && !strcmp(env, "DM_RENDER_SCALE")) {
             char *end; double x = strtod(s, &end);
             if (*s && !isspace((unsigned char)*s) && !strpbrk(s, "xX") && !*end && x == x) {   // as Setting.accepts (LauncherSettings.swift): no leading space, no hex, no NaN
@@ -146,7 +146,7 @@ static void saved_choices(void) {   // after the env files, before the bundle's
         if (CFGetTypeID(v) != CFStringGetTypeID() || !CFStringGetCString(v, s, sizeof s, kCFStringEncodingUTF8)) fprintf(stderr, "launcher: saved choice for %s ignored: not a string of at most %zu bytes\n", env, sizeof s - 1);
         else if (!saved_accepted(rule, v, s)) fprintf(stderr, "launcher: saved choice %s=%s ignored: this build does not offer it\n", env, s);
         else if (getenv(env)) fprintf(stderr, "launcher: saved choice %s=%s not used: %s=%s is set (environment or env.txt)\n", env, s, env, getenv(env));
-        else { setenv(env, s, 0); fprintf(stderr, "launcher: env %s=%s (saved choice)\n", env, s); }
+        else { const char *t = (!strcmp(env, "SWX_AA") && !strcmp(s, "0")) ? "off" : s; setenv(env, t, 0); fprintf(stderr, "launcher: env %s=%s (saved choice)\n", env, t); }
         CFRelease(v);
     }
 }
