+// SWX_AA tri-state for BOTW 1.9.0 on macOS. The anchored fullscreen
+// composite draw (scene -> canvas, fs key bd7ffdd435c6c3bc with vs
+// 5e9f57168d89a543, prim 4, 3 verts, indexed, 1x/frame) is either left to
+// the game or replaced by an inline copy pass into the canvas; read once
+// at launch, absent or empty means fxaa. The installer leaves it absent
+// (wrapper/main.py): the harness sets it per run.
+// - fxaa: the game default. The hook does nothing; the draw encodes shipped.
+// - off: the original composite draw remains, but its effective fragment
+//   CBUF slot 0 has c[3].xy (bytes 0x30/0x34) set to 1e30, disabling FXAA
+//   while preserving the game's own composition, upscale, mask and clear.
+// - smaa: SMAA only. The 3-pass filter below (edge into RG8Unorm, blend
+//   weights into RGBA8Unorm, neighbourhood blend) runs on the scene first,
+//   then the copy pass draws the FILTERED temporary into the canvas, and
+//   the game draw is skipped. Zero passes (no slot free, no room) leave the
+//   original draw with native FXAA thresholds neutralized by its effective fragment UBO.
+// Order with SWX_FXCAS: CAS sharpens first (fxcas_try at the draw entry);
+// SMAA and the copy consume its output (fxcas_tex) and disarm the one-shot
+// swap the skipped draw would have taken. The sampler, coordinates, format
+// and the game's RGB-only channel mask stay the draw's own.
+// Validation inside the hook (MNG-style, refs/mac-nativegames/games/totk/
+// third_party/d2r_gfx/gfx/nvn/botw_finish.h:50-99): 2D source, source
+// serial != canvas serial, no blend, RGB-only mask, full viewport and
+// scissor; anything else keeps the game draw and attempts c[3].xy neutralization
+// for verified variants, with an AA F marker if that effective UBO cannot be copied. No
+// MetalFX replacement path exists for this graphics draw (up_mfx_* handles
+// compute dispatches only; the present scaler runs after the canvas), so
+// unlike MNG's botw_fin_upscale there is no replaced case to honour.
+// SMAA reference: https://github.com/iryoku/smaa (MIT License; see
+// dm/gfx/msl/smaa.metal).
+static int swx_aa_mode(void) {
+    static int v = -2;
+    if (v == -2) {
+        const char *e = getenv("SWX_AA");
+        if (!e || !*e || !strcmp(e, "fxaa")) { v = SWX_AA_FXAA; MLOG("SWX_AA: mode fxaa (the game's FXAA draws; anchor fs=bd7ffdd435c6c3bc)"); }
+        else if (!strcmp(e, "off")) { v = SWX_AA_OFF; MLOG("SWX_AA: mode off (env=off; attempts verified FXAA c[3].xy neutralization when effective CBUF is safe; original composite draw preserved)"); }
+        else if (!strcmp(e, "smaa")) { v = SWX_AA_SMAA; MLOG("SWX_AA=smaa: mode smaa (the SMAA-filtered scene is copied into the canvas, the game draw skipped; anchor fs=bd7ffdd435c6c3bc)"); }
+        else { v = SWX_AA_FXAA; MLOG("[RED] SWX_AA=%s unknown (want off, fxaa or smaa): keeping the game's FXAA", e);
+            MLOG("SWX_AA: mode fxaa (the game's FXAA draws; anchor fs=bd7ffdd435c6c3bc)"); }
+    }
+    return v;
+}
