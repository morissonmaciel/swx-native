+int mtl_swx_vfr_acquire_credit(void) {
+    if (!swx_vfr_path()) return 0;
+    pthread_mutex_lock(&g_pq_mu);
+    // Re-read depth plus work on the way (untaken tickets, ticket under the
+    // worker): a recomposing reserve discards the pending recovery, missing
+    // work consumes it single-shot. Both clear the flag with no pacing
+    // effect (no observable difference yet); the next acquire stays nominal.
