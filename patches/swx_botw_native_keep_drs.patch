# SWX_NATIVE_RES presets keep the game's dynamic resolution (BOTW 1.9.0, macOS): the frontend publishes only the base.
# bp_force_internal() no longer writes state +0x14; that slot stays under the loader's SWX_DISABLE_DRS handling (0 keeps
# dynamic resolution around the new base, 1 fixes the scene for A/B control). +0x10 stays 1.0f while the preset is active,
# so DM_RENDER_SCALE remains ignored under the preset, and +0xB4 is still published only after the heap reservation check.
# Heaps, HUD, VFR snapshots and present keep using the preset size. Docs now call the preset the base and point to Fixed
# internal resolution for the reduction policy. No new flag, no ARM64 stub change.
# verify: dm/host/front_mac.m:+0x14 stays under the loader via SWX_DISABLE_DRS
# verify: dm/host/front_mac.m:uint32_t mode = (uint32_t)g_bp_mode
# verify: dm/host/front_mac.m:publishes the base resolution
# verify: dm/games/settings.tsv:Sets the base scene
# verify: docs/env_switches.tsv:keeps its dynamic resolution around the base unless
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -696,9 +696,9 @@
 - (void)viewDidChangeBackingProperties { [super viewDidChangeBackingProperties]; [self fitDrawable]; }
 @end
 
-// Native resolution (SWX_NATIVE_RES=1080p/1440p/2160p, legacy SWX_RES_BYPASS=1080p/1440p/4k, BOTW 1.9.0): internal resolution fixed at boot (1920x1080, 2560x1440 or 3840x2160), drawable follows the mode.
+// Native resolution (SWX_NATIVE_RES=1080p/1440p/2160p, legacy SWX_RES_BYPASS=1080p/1440p/4k, BOTW 1.9.0): base resolution (1920x1080, 2560x1440 or 3840x2160), drawable follows the mode.
 // The loader keeps the request host-side after validating the env value, the SWX_NATIVE_1080P capability and docked
-// mode; the frontend forces the internal resolution (+0x10 = 1.0f / +0x14 = 1, state +0xB4 = 1) at boot before the guest
+// mode; the frontend publishes the base resolution (+0x10 = 1.0f, state +0xB4 = mode) at boot before the guest
 // thread starts, in window and fullscreen alike. Window mode fixes the content at 1920x1080 pixels and re-verifies across
 // monitors; fullscreen lets the drawable follow the view and the stock present path scales it (MetalFX or bilinear per
 // DM_PRESENT_UPSCALE, picked by the presenter from the drawable). A lost 1:1 falls back to the normal present with the
@@ -718,7 +718,7 @@
     if (win && was.width > 0 && was.height > 0) [win setContentSize:was];
     LOG("front end: 1080p bypass off (%s); stock path", why);
 }
-// Force the internal resolution before the guest thread starts (window and fullscreen alike).
+// Publish the base resolution before the guest thread starts (window and fullscreen alike).
 // 1 = published, 0 = the 1440p/4K reservation was already fixed (the loader refused it): nothing is
 // published and the caller falls back to the stock path
 static int bp_force_internal(void) {
@@ -734,9 +734,9 @@
         LOG("front end: 1080p bypass off (guest reservation already fixed); stock path");
         return 0;
     }
-    float one = 1.0f; uint32_t on = 1, mode = (uint32_t)g_bp_mode;
-    memcpy(dm_fps_state + 0x10, &one, sizeof one); memcpy(dm_fps_state + 0x14, &on, sizeof on);
-    memcpy(dm_fps_state + 0xB4, &mode, sizeof mode);   // confirmed active: only now may the scene stub use the wide base
+    float one = 1.0f; uint32_t mode = (uint32_t)g_bp_mode;
+    memcpy(dm_fps_state + 0x10, &one, sizeof one);
+    memcpy(dm_fps_state + 0xB4, &mode, sizeof mode);   // confirmed active: only now may the scene stub use the wide base (+0x14 stays under the loader via SWX_DISABLE_DRS)
     g_bp_on = 1;
     return 1;
 }
