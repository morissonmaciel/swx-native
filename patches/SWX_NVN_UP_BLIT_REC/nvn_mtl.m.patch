+// SWX_NVN_UP_BLIT_REC=1 prototype: defer a whole upload batch's buffer->texture blits to the encode thread (one RO_COMMIT_UBATCH, in the same queue slot
+// rec_commit_upload would take). Why: with DM_NVN_ENC_THREAD=1 the draw replay already runs on the encode thread, so up_flush's blit encoding is the submit
+// thread's remaining per-batch Metal encoding. The GPU executes the same individual copies in the same order; deswizzle, draw replay, pool and VFR pacing are
+// untouched. The batch is only deferred when every entry is a plain buffer->texture copy; any texture read, intra-batch barrier, payload-build failure or
+// unavailable recorder sends the whole batch through the current path, never mixing both in one command buffer.
+static int up_ub_rec_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("SWX_NVN_UP_BLIT_REC"); v = e && atoi(e) != 0; }
+    return v;
+}
+typedef struct {   // one buffer->texture copy (src/dst: CFBridgingRetain refs, released after the replay emits them)
+    uint64_t src, dst;
+    uint64_t off, row, image, w, h, d, slice, level, ox, oy, oz;
+} up_ub_copy;
+typedef struct { int n; up_ub_copy c[]; } up_ubatch;   // immutable once built
+static int up_ub_rec_eligible(void) {
+    if (!up_ub_rec_on()) return 0;
+    if (!rec_on() || !g_rb_started) return 0;
+    if (g_nup_blits <= 0) return 0;
+    for (int i = 0; i < g_nup_blits; i++) {
+        up_blit *x = &g_up_blits[i];
+        if (x->tsrc || x->t2b || x->bar) return 0;
+        if (!x->src || !x->dst) return 0;
+    }
+    return 1;
+}
+static up_ubatch *up_ubatch_build(void) {
+    int n = g_nup_blits;
+    up_ubatch *u = malloc(sizeof *u + (size_t)n * sizeof u->c[0]);
+    if (!u) return NULL;
+    u->n = n;
+    for (int i = 0; i < n; i++) {
+        up_blit *x = &g_up_blits[i];
+        if (!x->src || !x->dst) { for (int j = 0; j < i; j++) { if (u->c[j].src) CFRelease((CFTypeRef)(uintptr_t)u->c[j].src); if (u->c[j].dst) CFRelease((CFTypeRef)(uintptr_t)u->c[j].dst); } free(u); return NULL; }
+        u->c[i].src = rec_obj(x->src);
+        u->c[i].dst = rec_obj(x->dst);
+        u->c[i].off = x->off; u->c[i].row = x->row; u->c[i].image = x->image;
+        u->c[i].w = x->size.width; u->c[i].h = x->size.height; u->c[i].d = x->size.depth;
+        u->c[i].slice = x->slice; u->c[i].level = x->level;
+        u->c[i].ox = x->at.x; u->c[i].oy = x->at.y; u->c[i].oz = x->at.z;
+    }
+    return u;
+}
+static void up_ubatch_discard(up_ubatch *u) {
+    if (!u) return;
+    for (int i = 0; i < u->n; i++) { if (u->c[i].src) CFRelease((CFTypeRef)(uintptr_t)u->c[i].src); if (u->c[i].dst) CFRelease((CFTypeRef)(uintptr_t)u->c[i].dst); }
+    free(u);
+}
+// The encode thread's half: emit the batch's barrier and copies on the real command buffer, then end and commit it like RO_COMMIT_REAL (rx_flush first in
+// rec_exec; same lock, same publish-before-commit, same queue call here), under the GPU-completion contract the submit thread's feedback handler set up.
+// tag carries the q4_commit_slow site string for the commit below (0 selects the default); up carries the up_ubatch payload, discarded here.
+static void up_ubatch_replay(uint64_t o, uint64_t cb, uint64_t tag, uint64_t up) {
+    id<MTL4CommandBuffer> ucb = (__bridge id)(void *)(uintptr_t)cb;
+    MTL4CommitOptions *uo = (__bridge id)(void *)(uintptr_t)o;
+    up_ubatch *ub = (up_ubatch *)(uintptr_t)up;
+    id<MTL4ComputeCommandEncoder> ue = [ucb computeCommandEncoder];
+    [ue barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageAll visibilityOptions:resource_vis()];
+    for (int i = 0; i < ub->n; i++) {
+        up_ub_copy *c = &ub->c[i];
+        enc_b_copy_buffer_texture(ue, (__bridge id<MTLBuffer>)(void *)(uintptr_t)c->src, (NSUInteger)c->off, (NSUInteger)c->row, (NSUInteger)c->image, MTLSizeMake((NSUInteger)c->w, (NSUInteger)c->h, (NSUInteger)c->d), (__bridge id<MTLTexture>)(void *)(uintptr_t)c->dst, (NSUInteger)c->slice, (NSUInteger)c->level, MTLOriginMake((NSUInteger)c->ox, (NSUInteger)c->oy, (NSUInteger)c->oz));
+    }
+    m4_end(ue);
+    up_ubatch_discard(ub);
+    cb_end(ucb, nil);
+    id<MTL4CommandBuffer> ubufs[] = {ucb};
+    pthread_mutex_lock(&g_res_commit_mu);   // apart from the residency set's commit, as RO_COMMIT_REAL and the present snapshot's queue commit (nvn_mtl.m res_commit)
+    uint64_t elapsed = q4_commit_elapsed(ubufs, 1, uo);
+    rx_mark_locked(); pthread_mutex_unlock(&g_res_commit_mu);
+    const char *site = tag ? (const char *)(uintptr_t)tag : "encode thread (upload batch)";
+    q4_commit_slow(elapsed, site);
+}
