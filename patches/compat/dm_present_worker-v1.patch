+// ---------- SWX VFR present worker (Etapa 1) ----------
+// Wait until the GPU has finished the producer work a queued ticket depends
+// on. Called without holding g_pq_mu. Slices the waits so a discard (going
+// to the background) or a lost GPU aborts the wait. Returns 1 once GPU
+// completion is confirmed, 0 on discard/GPU loss: the caller promotes only
+// on 1, so an aborted ticket is never marked ready.
+static int wk_wait_gpu(const pq_item *it) {
+    if (it->snap_v) {
+        // The snapshot copy: commit first, then its GPU completion signal.
+        snap_commit_wait(it->snap_v);
+        for (;;) {
+            if (!g_snap_ev || g_snap_ev.signaledValue >= it->snap_v) break;
+            if (atomic_load(&g_present_discard) || atomic_load(&g_gpu_lost)) return 0;
+            [g_snap_ev waitUntilSignaledValue:it->snap_v timeoutMS:100];
+        }
+    } else {
+        // No snapshot: the game's own draws (sub_v) and/or an external
+        // producer (ev_val), each with its corresponding wait.
+        if (it->ev_val && g_ext_ev) {
+            for (;;) {
+                if (g_ext_ev.signaledValue >= it->ev_val) break;
+                if (atomic_load(&g_present_discard) || atomic_load(&g_gpu_lost)) return 0;
+                [g_ext_ev waitUntilSignaledValue:it->ev_val timeoutMS:100];
+            }
+        }
+        if (it->sub_v) {
+            sub_commit_wait(it->sub_v);   // the encode thread has committed the submissions...
+            while (!mtl_wait(it->sub_v, 100000000ull)) {   // ...and the GPU has run them (submit is not enough)
+                if (atomic_load(&g_present_discard) || atomic_load(&g_gpu_lost)) return 0;
+            }
+        }
+    }
+    return 1;
+}
+static void *present_worker_main(void *arg) {
+    (void)arg;
+    pthread_setname_np("nvn-present-worker");
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    for (;;) {
+        pthread_mutex_lock(&g_pq_mu);
+        while (!swx_vfr_path() || g_pq_wk >= g_pq_in) pthread_cond_wait(&g_pq_cv, &g_pq_mu);
+        uint64_t ticket = g_pq_wk + 1;
+        if (ticket <= g_pq_done) { g_pq_wk = ticket; pthread_cond_broadcast(&g_pq_cv); pthread_mutex_unlock(&g_pq_mu); continue; }   // freed by a fallback while queued; skip without GPU wait (unlocked before looping back to the top lock)
+        pq_item it = g_pq[(ticket - 1) % PQ];
+        g_pq_wk = ticket; g_wk_inflight++;
+        pthread_mutex_unlock(&g_pq_mu);
+        int gpu_ok = wk_wait_gpu(&it);   // 1 once GPU completion is confirmed; 0 aborts the promotion below
+        pthread_mutex_lock(&g_pq_mu);
+        g_wk_inflight--;
+        if (!gpu_ok || ticket <= g_pq_done) {
+            mtl_tex_unpin(it.t.serial);   // aborted, or a stall/suspend fallback freed this ticket while it waited
+        } else {
+            while (g_rdy_in - g_rdy_read >= SWX_RDY) pthread_cond_wait(&g_pq_cv, &g_pq_mu);
+            if (ticket <= g_pq_done) mtl_tex_unpin(it.t.serial);
+            else { g_rdy[g_rdy_in % SWX_RDY] = it; g_rdy_ticket[g_rdy_in % SWX_RDY] = ticket; g_rdy_in++; }
+        }
+        pthread_cond_broadcast(&g_pq_cv);
+        pthread_mutex_unlock(&g_pq_mu);
+    }
+    return NULL;
 }
