+// Saved native-resolution choice (launcher.SWX_NATIVE_RES, legacy launcher.SWX_RES_BYPASS): migrate the legacy
+// key once, keep the canonical one when both exist, drop the legacy key so Reset cannot resurrect it. Skipped
+// with DM_SAVED_CHOICES=0. Runs before the window and before the no-window saved-choices read.
+static void migrate_saved_res(void) {
+    const char *off = getenv("DM_SAVED_CHOICES");
+    if (off && !strcmp(off, "0")) return;
+    CFStringRef domain = CFBundleGetIdentifier(CFBundleGetMainBundle());
+    if (!domain) return;
+    CFStringRef newK = CFStringCreateWithFormat(NULL, NULL, CFSTR("launcher.SWX_NATIVE_RES"));
+    CFStringRef oldK = CFStringCreateWithFormat(NULL, NULL, CFSTR("launcher.SWX_RES_BYPASS"));
+    if (!newK || !oldK) { if (newK) CFRelease(newK); if (oldK) CFRelease(oldK); return; }
+    CFPropertyListRef nv = CFPreferencesCopyAppValue(newK, domain);
+    CFPropertyListRef ov = CFPreferencesCopyAppValue(oldK, domain);
+    char ns[64] = "", os[64] = "";
+    int hasNew = nv && CFGetTypeID(nv) == CFStringGetTypeID() && CFStringGetCString(nv, ns, sizeof ns, kCFStringEncodingUTF8) && *ns;
+    int hasOld = ov && CFGetTypeID(ov) == CFStringGetTypeID() && CFStringGetCString(ov, os, sizeof os, kCFStringEncodingUTF8) && *os;
+    if (hasNew) {
+        if (hasOld) { CFPreferencesSetAppValue(oldK, NULL, domain); CFPreferencesAppSynchronize(domain); fprintf(stderr, "launcher: dropped legacy saved choice SWX_RES_BYPASS (SWX_NATIVE_RES kept)\n"); }
+    } else if (hasOld) {
+        if (!strcmp(os, "1080p") || !strcmp(os, "1440p") || !strcmp(os, "2160p") || !strcmp(os, "4k") || !strcmp(os, "0")) {
+            const char *t = !strcmp(os, "4k") ? "2160p" : os;
+            CFStringRef v = CFStringCreateWithCString(NULL, t, kCFStringEncodingUTF8);
+            if (v) { CFPreferencesSetAppValue(newK, (CFPropertyListRef)v, domain); CFRelease(v); }
+            CFPreferencesSetAppValue(oldK, NULL, domain);
+            CFPreferencesAppSynchronize(domain);
+            fprintf(stderr, "launcher: migrated saved choice SWX_RES_BYPASS=%s to SWX_NATIVE_RES=%s\n", os, t);
+        } else {
+            CFPreferencesSetAppValue(oldK, NULL, domain); CFPreferencesAppSynchronize(domain);
+            fprintf(stderr, "launcher: dropped invalid legacy saved choice SWX_RES_BYPASS=%s\n", os);
+        }
+    }
+    if (nv) CFRelease(nv); if (ov) CFRelease(ov);
+    CFRelease(newK); CFRelease(oldK);
+}
