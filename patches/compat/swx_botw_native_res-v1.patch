+// Native resolution (SWX_NATIVE_RES, legacy SWX_RES_BYPASS): the canonical key wins, including 0; the legacy
+// alias 4k reads as 2160p when the canonical key is absent. Normalized here after the env files so the UI and
+// the no-window boot use the same decision the loader validates, before the fixed-key lists are published.
+static int has_key(const char *list, const char *k) {
+    if (!list || !*list) return 0;
+    size_t n = strlen(k);
+    for (const char *p = list;;) {
+        while (*p == ' ') p++;
+        if (!*p) return 0;
+        if (!strncmp(p, k, n) && (p[n] == ' ' || p[n] == 0)) return 1;
+        while (*p && *p != ' ') p++;
+    }
+}
+
+static void normalize_native_res(void) {
+    const char *nr = getenv("SWX_NATIVE_RES");
+    const char *lb = getenv("SWX_RES_BYPASS");
+    if ((!nr || !*nr) && lb && *lb) {
+        const char *t = !strcmp(lb, "4k") ? "2160p" : lb;
+        setenv("SWX_NATIVE_RES", t, 1);
+        fprintf(stderr, "launcher: env SWX_NATIVE_RES=%s (from legacy SWX_RES_BYPASS=%s)\n", t, lb);
+        if (has_key(g_file_keys, "SWX_RES_BYPASS") && !has_key(g_file_keys, "SWX_NATIVE_RES")) add_key(&g_file_keys, "SWX_NATIVE_RES");
+        if (has_key(g_launch_keys, "SWX_RES_BYPASS") && !has_key(g_launch_keys, "SWX_NATIVE_RES")) add_key(&g_launch_keys, "SWX_NATIVE_RES");
+    }
+}
