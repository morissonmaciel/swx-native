 static id<MTLComputePipelineState> g_nvn_deswz_pipeline, g_nvn_deswz_direct;
 
+// SWX_GPU_BIND_ONCE=1 suppresses only repeated deswizzle bindings on an
+// unchanged upload encoder. Its owner invalidates the cache before every
+// external table/pipeline mutation; per-slice setAddress writes stay intact.
 // The kernels deswz and deswz_direct: dm/gfx/msl/deswz.metal
 
+static __weak id g_m4_enc; static int g_m4_which; static __weak id g_m4_table;
+static _Atomic uint64_t g_m4_attempted, g_m4_emitted, g_m4_skipped, g_m4_invalidated;
+static int m4_bind_once_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("SWX_GPU_BIND_ONCE"); v = e && atoi(e) != 0;
+        if (v) LOG("[nvn-deswz] SWX_GPU_BIND_ONCE=1: suppressing repeated upload deswizzle bindings"); }
+    return v;
+}
+void nvn_deswz_gpu_m4_invalidate(id<MTL4ComputeCommandEncoder> enc) {
+    if (!enc || enc == g_m4_enc) { g_m4_enc = nil; g_m4_table = nil; g_m4_which = 0; atomic_fetch_add(&g_m4_invalidated, 1); }
+}
+void nvn_deswz_gpu_m4_stats(uint64_t *attempted, uint64_t *emitted, uint64_t *skipped, uint64_t *invalidated) {
+    *attempted = atomic_load(&g_m4_attempted); *emitted = atomic_load(&g_m4_emitted);
+    *skipped = atomic_load(&g_m4_skipped); *invalidated = atomic_load(&g_m4_invalidated);
+}
+static void bind_m4(id enc, id table, int which, id pso) {
+    atomic_fetch_add(&g_m4_attempted, 1);
+    if (m4_bind_once_on() && enc == g_m4_enc && which == g_m4_which && table == g_m4_table) { atomic_fetch_add(&g_m4_skipped, 1); return; }
+    [enc setArgumentTable:table]; [enc setComputePipelineState:pso];
+    atomic_fetch_add(&g_m4_emitted, 1);
+    g_m4_enc = enc; g_m4_which = which; g_m4_table = table;
+}
