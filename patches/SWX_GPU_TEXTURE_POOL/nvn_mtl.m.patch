+// SWX_GPU_TEXTURE_POOL=1: unified texture-loading improvements (default off).
+// 6x32MB private blocks stay resident across batches; take = find free (busy
+// bit clear) instead of per-batch newBuffer+res_add; retire = clear busy bit
+// on upload completion instead of res_remove. Slice 2 pre-reserve: resident
+// pool blocks add no new bytes, so the 128 MB batch cap counts the texture's
+// own bytes instead of whole-block sizes; stock keeps the worst-case block cost.
+// One-offs (>32MB, pool exhausted) keep today's path. Slot retention, commit
+// and fence ordering are untouched.
+#define SWX_UP_POOL_N 6
+static __strong id<MTLBuffer> g_swx_pool[SWX_UP_POOL_N];
+static _Atomic uint64_t g_swx_pool_busy;
