+static inline uint64_t swx_vfr_bits(float seconds) {
+    float ratio = seconds * 30.0f;
+    uint32_t lo, hi;
+    memcpy(&lo, &ratio, sizeof lo);
+    memcpy(&hi, &seconds, sizeof hi);
+    return (uint64_t)lo | ((uint64_t)hi << 32);
+}
