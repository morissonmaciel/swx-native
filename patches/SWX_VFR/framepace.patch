+// Sample the time between game presents. The first sample only anchors the
+// clock. A discontinuity starts a new averaging window and contributes no
+// simulation step, so loads do not get replayed as owed time.
+static inline double swx_vfr_present_step(swx_vfr_pace *pace,
+                                          uint64_t present_ns,
+                                          uint64_t *bits,
+                                          int count_vfr_step) {
+    if (!pace->prev_present_ns) {
+        pace->prev_present_ns = present_ns;
+        return 0.0;
+    }
+
