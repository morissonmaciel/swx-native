+static void swx_vfr_config_init(void) {
+#if !TARGET_OS_OSX
+    g_vfr_policy = SWX_VFR_DISABLED;
+    return;
+#endif
+    const char *mode = getenv("SWX_VFR");
+    if (mode && !strcmp(mode, "relaxed")) g_vfr_policy = SWX_VFR_LOCK;
+    else if (mode && !strcmp(mode, "uncapped")) g_vfr_policy = SWX_VFR_UNCAPPED;
+    else if (mode && *mode && strcmp(mode, "0"))
+        LOG("[RED] SWX_VFR=%s: use 0, relaxed or uncapped; VFR is off", mode);
+    const char *e = getenv("SWX_VFR_HZ");
+    unsigned hz = 0;
+    if (!e || !strcmp(e, "auto")) hz = g_vfr_policy == SWX_VFR_UNCAPPED ? 144u : 60u;
+    else {
+        char *end = NULL;
+        long parsed = strtol(e, &end, 10);
+        if (end != e && !*end && parsed >= 30 && parsed <= 240) hz = (unsigned)parsed;
+    }
+    if (g_vfr_policy != SWX_VFR_DISABLED && !hz) {
+        LOG("[RED] SWX_VFR_HZ=%s: use auto or 30..240; VFR is off", e ? e : "(unset)");
+        g_vfr_policy = SWX_VFR_DISABLED;
+        return;
+    }
+    g_vfr_target_hz = hz;
+    atomic_store_explicit(&g_vfr_link_locked, g_vfr_policy == SWX_VFR_LOCK, memory_order_release);
+    if (g_vfr_policy != SWX_VFR_DISABLED)
+        LOG("[nvn] VFR cadence: %s, %u Hz target (%s)",
+            g_vfr_policy == SWX_VFR_UNCAPPED ? "uncapped" : "lock",
+            hz, e && strcmp(e, "auto") ? "SWX_VFR_HZ" : "auto");
+}
