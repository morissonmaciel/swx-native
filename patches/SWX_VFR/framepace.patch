+static unsigned swx_vfr_policy(void) { pthread_once(&g_vfr_config_once, swx_vfr_config_init); return (unsigned)g_vfr_policy; }
+static unsigned swx_vfr_configured_hz(void) { pthread_once(&g_vfr_config_once, swx_vfr_config_init); return g_vfr_target_hz; }
+
+static unsigned swx_vfr_resolve_hz(unsigned *source) {
+    *source = 0;
+    if (swx_vfr_policy() == SWX_VFR_DISABLED || !dm_vfr_capable || !dm_fps_state || dm_detclock_enabled()) return 0;
+    unsigned configured_hz = swx_vfr_configured_hz();
+    if (!configured_hz) return 0;
+    int movie = dm_movie_hz();
+    if (movie > 0) { *source = 1; return 30u; }
+    uint32_t interval = __atomic_load_n((uint32_t *)(dm_fps_state + 0x24), __ATOMIC_RELAXED);
+    if (interval > 0 && interval <= 6) { *source = 1u + interval; return 60u / interval; }
+    return configured_hz;
+}
+
+int nvn_swx_vfr_rate(void) {
+    return (int)atomic_load_explicit(&g_vfr_effective_rate, memory_order_acquire);
+}
+
+int nvn_swx_vfr_divisor(int link_hz) {
+    unsigned hz = (unsigned)nvn_swx_vfr_rate();
+    if (!hz || !atomic_load_explicit(&g_vfr_link_locked, memory_order_acquire) || link_hz <= 0 || (unsigned)link_hz < hz || (unsigned)link_hz % hz)
+        return 0;
+    return link_hz / (int)hz;
+}
