+typedef struct {
+    uint64_t prev_present_ns;
+    double samples[SWX_VFR_NSAMPLES];
+    unsigned count;
+    unsigned next;
+    uint64_t steps;
+    uint64_t n;
+    double raw_sum_s;
+    double applied_sum_s;
+
