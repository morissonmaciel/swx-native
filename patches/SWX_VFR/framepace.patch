+#define SWX_VFR_NSAMPLES 5
+#define SWX_VFR_STEP_MAX_S (1.0 / 15.0)
+#define SWX_VFR_DT_MIN_S 0.001
+#define SWX_VFR_DT_MAX_S 0.25
+#define SWX_VFR_CLOCK_HZ_MAX 240
