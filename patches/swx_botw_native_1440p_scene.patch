# SWX_RES_BYPASS=1440p scene for BOTW 1.9.0 on macOS, stage 2: the docked stub's 1440p path emits {2560.0f, 2560.0f}.
# Only the second word of the mode-2 branch changes (movk x8, #0x44f0 -> #0x4520, lsl #48); the movz, the 1080p path
# and the stock path are untouched. The frontend activation log names the effective preset (was always "1080p"), the
# launcher offers 1440p on macOS builds declaring SWX_NATIVE_1440P, and the flag description covers both presets.
# verify: dm/games/01007EF00011E000/patches.py:emit(0xd2a8a408); emit(0xf2e8a408)
# verify: dm/games/01007EF00011E000/patches.py:path1440: {2560.0f, 2560.0f}
# verify: dm/games/settings.tsv:1440p=1440p (2560x1440)?platform:mac&fixups:SWX_NATIVE_1440P
# verify: dm/host/front_mac.m:"1440p bypass active" : "1080p bypass active"
# verify: dm/host/front_mac.m:bp_label
# verify: docs/env_switches.tsv:`1440p` renders them at 2560x1440
--- a/dm/games/01007EF00011E000/patches.py
+++ b/dm/games/01007EF00011E000/patches.py
@@ -318,15 +318,15 @@
                        (0x12660c8, '0899e8f2'), (0x12660cc, '680a09f9')):
         fs_site(site, orig)
     # Bypass mode (+0xB4 u32: 0 = off, 1 = 1080p, 2 = 1440p). cbz/lsr never touch the flags and the scratch
-    # register is each site's own destination, so no guest state leaks into the check. Stage 1 renders 1920 wide in
-    # both presets (scene 1920x1080); the 1440p half only widens the screen half to 2560.0f
+    # register is each site's own destination, so no guest state leaks into the check. Stage 2 renders 2560 wide in
+    # the 1440p preset (scene 2560x1440); the 1080p preset keeps 1920 (scene 1920x1080)
     def cbz_w(r, words): return 0x34000000 | (r & 31) | ((words & 0x7ffff) << 5)
     def lsr1_w(r): return 0x53000000 | (1 << 16) | (31 << 10) | ((r & 31) << 5) | (r & 31)   # lsr wR,wR,#1: 1 -> 0, 2 -> 1
     def ldr_b4(r): return 0xB9400000 | (45 << 10) | ((r & 31) << 5) | (r & 31)   # ldr wR,[xR,#0xB4]
     def leword(hexstr): return struct.unpack('<I', bytes.fromhex(hexstr))[0]   # LE-hex (fs_site form) to word
     bypass = here(); emit(ADRP(8, here(), FS_STATE_OFF))
     emit(ldr_b4(8)); emit(cbz_w(8, 9)); emit(lsr1_w(8)); emit(cbz_w(8, 4))
-    emit(0xd2a8a408); emit(0xf2e89e08); emit(B(here(), 0x12660cc))   # path1440: {2560.0f, 1920.0f} (stage 1)
+    emit(0xd2a8a408); emit(0xf2e8a408); emit(B(here(), 0x12660cc))   # path1440: {2560.0f, 2560.0f} (stage 2: native scene)
     emit(0xd2a89e08); emit(0xf2e89e08); emit(B(here(), 0x12660cc))   # path1080: {1920.0f, 1920.0f}
     emit(0xd2a89e08); emit(0xf2e89908); emit(B(here(), 0x12660cc))   # stock: {1920.0f, 1600.0f} as shipped
     fs_put(0x12660c8, [B(0x12660c8, bypass)], 'docked render width = 1920 with the 1080p bypass, 1600 as shipped'); ctx.capabilities.add('SWX_NATIVE_1080P')
